    // A motor-bearing component of the robot, an arm or gripper driver,
    // named by `component` in every resource, as the launcher wrote its
    // instance (left_arm_inst, follower_inst): its per-motor health as a
    // resource per robot and component, on the robots whose drivers report
    // it.
    motor_health: {
      contract: {
        name: "motor_health",
        tag: "v1",
        sha256: "da7274b6cf78dfaf8ca6cdd52d54a2ceb79cf8626605fb22f223b8ddf35e866d",
      },
      argument: "component",
      topics: [
        {
          member: "motor_health",
          resource: "motor_health.latest_report",
          description: "The component's latest motor health report: level per motor, the severity the component judged from the readings that follow, 0 nominal, 1 warning, 2 critical, 3 fault, 4 not reporting, and index-aligned with it effort_fraction_rated and effort_fraction_rated_sustained, the live and the filtered effort as fractions of the motor's continuous rating, the filtered one being what level judges, effort_fraction_peak, the live effort as a fraction of the motor's effective peak, 1.0 its own trip point, and driver_temp_c and winding_temp_c in degrees Celsius, in the component's fixed motor order, at timestamp. A reading array is empty for a component without that sensing. A report that stops arriving reads as stale after 1.5 s: the component went quiet, which says nothing of the motors' health. alerts.active of the same component names in words the motor each condition is about.",
          // The reports repeat at least every 500 ms; three missed periods
          // mean the component went quiet.
          freshness: { max_age_ms: 1500 },
          update: { max_hz: 5 },
          // Every array has one entry per motor, so the runtime size policy
          // is mandatory; a seven-motor arm's report is about 1 KiB, and one
          // larger than this is a fault to refuse.
          max_result_bytes: 4096,
          on_oversize: "reject",
        },
      ],
    },

    // The operator alerts the same components hold active: a resource per
    // robot and component.
    alerts: {
      contract: {
        name: "alert",
        tag: "v1",
        sha256: "71702fabcdb3acab3d056634541adf27bbc5975edbcf52b7b6cab534dfd40f7a",
      },
      argument: "component",
      topics: [
        {
          member: "alerts",
          resource: "alerts.active",
          description: "The whole set of alerts the component holds active, published whenever it changes and at least every 2 s: for each, source, what it is about in operator words, such as a motor; kind, the component's name for the condition; severity, 1 warning, 2 critical, 3 fault; and message, the measurement that drove it, at timestamp. Empty when the component holds none. A set that stops arriving reads as stale after 6 s: the component went quiet and its conditions are unknown, not cleared.",
          // The sets repeat at least every 2000 ms; three missed periods
          // mean the component went quiet.
          freshness: { max_age_ms: 6000 },
          update: { max_hz: 5 },
          // The entries carry operator text, so the runtime size policy is
          // mandatory; a driver holds at most one alert per motor.
          max_result_bytes: 8192,
          on_oversize: "reject",
        },
      ],
    },

    // A color camera: one per camera of the robot, named by `camera` on
    // every call, as the launcher wrote its instance (wrist_left, wrist).
    // The topic becomes a resource per robot and camera, published as JPEG
    // at no more than 2 Hz however fast the camera streams, and the picture
    // tool a model looks through the camera with.
    camera: {
      contract: {
        name: "rgb_camera",
        tag: "v1",
        sha256: "ff5063bea27d4b67d73a6b40c875f0ec45834c9b4111b0a0690517853d68418d",
      },
      argument: "camera",
      topics: [
        {
          member: "video_stream",
          resource: "camera.latest_frame",
          description: "The camera's latest picture. A read gives the message without its picture, as JSON: header with frame, the camera's frame, the capture timestamp and capture_index, the capture counter, encoding, width and height; and data, the picture, as a JPEG blob. To look through the camera, call camera.look, which answers with the same picture.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "data",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          // data is a variable-length byte array, so the runtime size
          // policy is mandatory.
          max_result_bytes: 524288,
          on_oversize: "downscale",
          // The same snapshot through a tool, whose result carries the
          // picture as an image.
          picture: {
            tool: "camera.look",
            description: "Look through one of the robot's color cameras: its latest picture as a JPEG, with the camera's frame, the capture timestamp, width and height. robot is one of the names robot.list reports, and camera one of the names the listing gives that robot under members.camera. Changes nothing.",
          },
        },
      ],
      // Each service becomes a tool that answers within one request. One
      // schema serves every device, so a value outside a device's range is
      // refused by the device at call time, not by the schema;
      // camera_profile.get is where a model reads the range first.
      services: [
        {
          member: "video_stream_info",
          tool: "camera.info",
          description: "Report the camera stream's resolution, frame rate and encoding. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "set_exposure",
          tool: "camera.set_exposure",
          description: "Set the camera's exposure. mode is auto or manual; value is the manual exposure in the device's unit and range, which camera_profile.get reports, and is ignored in auto mode. A refused request changes nothing. Answers with current_value, the effective exposure after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "set_gain",
          tool: "camera.set_gain",
          description: "Set the camera's gain in the device's unit and range, which camera_profile.get reports. A refused request changes nothing. Answers with current_value, the effective gain after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "set_white_balance",
          tool: "camera.set_white_balance",
          description: "Set the camera's white balance. mode is auto or manual; temperature is the manual color temperature in kelvin, in the device's range, and is ignored in auto mode. A refused request changes nothing. Answers with current_temperature, the effective temperature after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
      ],
      // `set_brightness` and `set_contrast` are live on the cameras and
      // absent here: the devices have no measured response for either, so
      // a simulated twin has no device model to answer them with.
    },

    // A camera that carries depth beside its color: one per such camera of
    // the robot, named by `camera` on every call.
    // Its color frame is a resource as a color camera's is, and its depth
    // frame two more from the one contract member: a grayscale picture to
    // look at and the lossless samples to compute with. The two pictures are
    // picture tools too; the samples are data and stay a resource.
    depth_camera: {
      contract: {
        name: "rgbd_camera",
        tag: "v1",
        sha256: "fddde6edcfed73c464431e18bf1bc5d96378927507719b8cec6761fb020fb7df",
      },
      argument: "camera",
      topics: [
        {
          member: "video_stream",
          resource: "depth_camera.latest_frame",
          description: "The camera's latest color picture. A read gives the message without its picture, as JSON: header with frame, the camera's frame, the capture timestamp, capture_index, the capture counter it shares with the depth picture of the same capture, and align_mode, encoding, width and height; and data, the picture, as a JPEG blob. To look through the camera, call depth_camera.look, which answers with the same picture.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "data",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          max_result_bytes: 524288,
          on_oversize: "downscale",
          picture: {
            tool: "depth_camera.look",
            description: "Look through one of the robot's cameras that carry depth: its latest color picture as a JPEG, with the camera's frame, the capture timestamp, width and height. robot is one of the names robot.list reports, and camera one of the names the listing gives that robot under members.depth_camera. Changes nothing.",
          },
        },
        {
          member: "depth_stream",
          resource: "depth_camera.latest_depth_picture",
          description: "The camera's latest depth picture drawn in grayscale, from the same viewpoint as depth_camera.latest_frame: white is near, black is far, the shades between are linear in distance, and black also marks a pixel the camera measured nothing at. The shading runs from 100 to 10000 sample steps of the depth_unit depth_camera.depth_info reports, so on a camera measuring in millimeters white is 0.1 m or nearer and black 10 m or farther. A read gives the message without its picture, as JSON: header with frame, the camera's frame, the capture timestamp, capture_index and align_mode, encoding, width and height; and data, the picture, as a JPEG blob. To see how far things are, call depth_camera.look_depth, which answers with the same picture; read depth_camera.latest_depth_samples for the measurements themselves.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "data",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
            // The ends of the shading, in the frame's own sample counts.
            depth_range: { near: 100, far: 10000 },
          },
          max_result_bytes: 524288,
          on_oversize: "downscale",
          picture: {
            tool: "depth_camera.look_depth",
            description: "See how far things are from one of the robot's cameras that carry depth: its latest depth picture as a grayscale JPEG, from the same viewpoint as depth_camera.look. White is near, black is far, the shades between are linear in distance, and black also marks a pixel the camera measured nothing at. The shading runs from 100 to 10000 sample steps of the depth_unit depth_camera.depth_info reports, so on a camera measuring in millimeters white is 0.1 m or nearer and black 10 m or farther. robot is one of the names robot.list reports, and camera one of the names the listing gives that robot under members.depth_camera. Changes nothing.",
          },
        },
        {
          member: "depth_stream",
          resource: "depth_camera.latest_depth_samples",
          description: "The camera's latest depth picture as measured: one 16-bit sample per pixel in the unit depth_camera.depth_info reports as depth_unit (meters per sample step), 0 where the camera measured nothing, aligned to the color picture as header.align_mode says. A read gives the message without its samples, as JSON: header with frame, the camera's frame, the capture timestamp, capture_index and align_mode, encoding, width and height; and data, the samples, as a 16-bit PNG blob. With align_mode none the samples are in the depth imager's own optical frame, which camera_geometry.depth_to_color places in the camera's frame. Read this one to compute with the measurements; call depth_camera.look_depth to see how far things are.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          // Lossless: a depth map is data, and downscaling keeps every
          // second sample as measured. Data is no picture for a model, so
          // this entry declares no picture tool.
          representation: {
            image: "png16",
            fields: {
              data: "data",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          max_result_bytes: 1048576,
          on_oversize: "downscale",
        },
      ],
      services: [
        {
          member: "video_stream_info",
          tool: "depth_camera.info",
          description: "Report the camera's color stream's resolution, frame rate and encoding. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "depth_stream_info",
          tool: "depth_camera.depth_info",
          description: "Report the camera's depth stream's resolution, frame rate and encoding, and depth_unit, the meters one sample step of depth_camera.latest_depth_samples stands for. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "set_color_exposure",
          tool: "depth_camera.set_exposure",
          description: "Set the camera's color exposure. mode is auto or manual; value is the manual exposure in the device's unit and range, which camera_profile.get reports, and is ignored in auto mode. A device that runs automatic exposure only refuses mode manual. A refused request changes nothing. Answers with current_value, the effective exposure after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "set_color_gain",
          tool: "depth_camera.set_gain",
          description: "Set the camera's color gain in the device's unit and range, which camera_profile.get reports. A refused request changes nothing. Answers with current_value, the effective gain after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "set_color_white_balance",
          tool: "depth_camera.set_white_balance",
          description: "Set the camera's color white balance. mode is auto or manual; temperature is the manual color temperature in kelvin, in the device's range, and is ignored in auto mode. A refused request changes nothing. Answers with current_temperature, the effective temperature after the call.",
          operation: "mutating",
          deadline_ms: 2000,
        },
      ],
      // `set_color_brightness` and `set_color_contrast` absent, as on a
      // color camera.
    },

    // What a camera's controls are and support, where the camera
    // implements the contract: the simulations' rendered cameras do.
    camera_profile: {
      contract: {
        name: "camera_profile",
        tag: "v1",
        sha256: "651e2c3703a2997fb94937b7589c4c81ca2e33281b72965550d79572737735f4",
      },
      argument: "camera",
      services: [
        {
          member: "get_camera_profile",
          tool: "camera_profile.get",
          description: "Report the camera's profile as JSON text in profile_json: the controls it supports, each with its unit, range and default. Read it before setting a control. A camera that is not attached to its device or simulation yet refuses with precondition_failed. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "reset_camera",
          tool: "camera_profile.reset",
          description: "Return every control of the camera to its default. Changes the camera's controls and nothing else.",
          operation: "mutating",
          deadline_ms: 2000,
        },
      ],
    },

    // Where a camera's pixels point, where the camera implements the
    // contract: the intrinsics of its color and depth streams and the
    // transform between them.
    camera_geometry: {
      contract: {
        name: "camera_geometry",
        tag: "v1",
        sha256: "e803e8712edb4bc442db360ddbc3be2c87ebf8cbc5c887f073a10f6657447359",
      },
      argument: "camera",
      services: [
        {
          member: "get_color_intrinsics",
          tool: "camera_geometry.color_intrinsics",
          description: "Report the color stream's pinhole intrinsics: width and height in pixels, fx, fy, cx and cy in pixels, and the distortion_model with its distortion coefficients. A camera that has not heard from its simulation yet refuses with precondition_failed, and a device without a calibration with rejected. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "get_depth_intrinsics",
          tool: "camera_geometry.depth_intrinsics",
          description: "Report the depth stream's pinhole intrinsics as camera_geometry.color_intrinsics does, with depth_model, min_depth_m and max_depth_m in meters, and align_mode, how the depth picture aligns to the color picture. A camera without a depth stream refuses with rejected. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "get_depth_to_color_extrinsics",
          tool: "camera_geometry.depth_to_color",
          description: "Report where the depth stream's optical frame sits in the color stream's: depth_to_color, the depth optical frame's pose in frame, the camera's frame, which is the color optical frame, with no timestamp since it holds at every time, with position in meters and orientation a unit quaternion [x, y, z, w], position [0, 0, 0] and orientation [0, 0, 0, 1] when the streams are aligned; and align_mode. A camera without a depth stream refuses with rejected. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
      ],
    },

    // Where the robot carries its sensors: its initializer answers from the
    // robot's model, naming the robot frame and each sensor's frame in the
    // robot's tree of frames.
    sensor_mounts: {
      contract: {
        name: "sensor_mounts",
        tag: "v1",
        sha256: "6fc11a94df50e10262f5ba351e5797a4ca056bad6a5fb24424ba68e57c62eff6",
      },
      services: [
        {
          member: "describe_sensors",
          tool: "robot.describe_sensors",
          description: "Report where the robot carries its sensors: robot_frame, the name of the robot frame in the robot's tree of frames; and index-aligned, sensor_names, the name each sensor runs under, in the robot's fixed order, a camera's being the name robot.list gives under members; sensor_kinds, rgbd_camera for a camera that carries depth, listed under members.depth_camera, rgb_camera for a color camera, listed under members.camera, and lidar_2d for a 2-D lidar; sensor_frames, the frame of each sensor in the robot's tree, which robot.lookup_transform places, a camera's being its color optical frame, +X to the right of the image, +Y down it, +Z along the view, the frame its pictures name in header.frame; and carried_by, the arm that carries each sensor, by the name the limb tools take, or empty for one fixed to the robot's body. A sensor of the robot's design that robot.list does not give under members has no stream on this endpoint. A robot without sensors answers empty arrays. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
      ],
    },

    // Where one frame of the robot stands in another: the robot's transform
    // server answers from the robot's tree of frames, the fixed joints its
    // initializer publishes and the joints its backbone measures.
    transform_lookup: {
      contract: {
        name: "transform_lookup",
        tag: "v1",
        sha256: "91bc0b9f7fb306ff5c49aacfc47d5e0d80fac4ae24696f10488dd1e46139d606",
      },
      services: [
        {
          member: "lookup_transform",
          tool: "robot.lookup_transform",
          description: "Learn where one frame of the robot stood at one time in another as it stands at a time: source_frame placed in target_frame, each a frame of the robot's tree, such as the robot_frame and the sensor_frames robot.describe_sensors gives, or a link planner.describe_arms names. source_timestamp is the time of source_frame's place and target_timestamp the time of target_frame's, each an RFC 3339 time such as the capture timestamp in the header of a camera picture, or left out for the latest time the robot's tree holds, by the frame rule. With both left out or both the same time, the answer is the lookup at that time. With different times it goes through the root of source_frame's chain, the frame that holds still across a move of the robot (odom or map on a mobile base, the robot frame on a fixed one): source_frame in that root at source_timestamp, then that root in target_frame at target_timestamp, so a pose in the robot frame read before a move of the base, looked up with no target_timestamp, names the same place on the floor after it. timeout_s is how long the robot waits for its tree to reach those times, in seconds, from 0, which answers at once, to 1. The robot answers lookups one at a time, in the order they arrive, so a lookup can wait behind the waits of the lookups before it. Answers with frame, the target_frame; child_frame, the source_frame; position [x, y, z] in meters and orientation, a unit quaternion [x, y, z, w], so a point p of child_frame stands at R(orientation) * p + position in frame; and timestamp, the time of target_frame's place, left out when the answer holds at every time, as for a camera fixed to the robot's body. The way to use it: to learn where a pixel of a camera stands in the robot frame now, deproject the pixel with camera_geometry.color_intrinsics and its sample of depth_camera.latest_depth_samples into a point p of the frame its picture's header names, and look that frame up in the robot_frame with source_timestamp the capture timestamp of that picture and no target_timestamp: R(orientation) * p + position is the point in the robot frame. robot.move_arm takes p itself, in that frame at that timestamp, and places it the same way. Where a part is fixed to another, the answer is the robot's design: exact in a simulation, nominal on a physical robot, whose parts stand within the tolerance of their mounts. A lookup that fails gives a kind of the frame rule, extrapolation once timeout_s has passed, and message names the cause. Changes nothing.",
          operation: "read_only",
          // A request waits up to its timeout_s, from 0 to 1 s as
          // transform_lookup bounds it, and the answer then comes within the
          // 2 s every read of this document has. The robot answers one
          // request at a time, so a call queued behind the waits of other
          // requests can end at this deadline.
          deadline_ms: 3000,
          // The contract's bound on timeout_s, in the tool's input schema.
          restrict: { timeout_s: { min: 0, max: 1 } },
        },
      ],
    },

    // Where each robot can work, where the robot implements the contract:
    // the backbone answers from the robot's design and the field of view of
    // the camera it finds items with, in the robot frame, and knows nothing
    // of the room.
    workspace: {
      contract: {
        name: "workspace",
        tag: "v1",
        sha256: "3062c0b71848d74ef7307a69379cb70e352c8b22fc05ac19f6b38c8f7c38af2e",
      },
      services: [
        {
          member: "describe_workspace",
          tool: "robot.describe_workspace",
          description: "Learn where on a flat, level surface the robot can work, from the robot's design and the field of view of its perception camera, the one depth camera no arm carries, which it finds items with. It knows nothing of the room: it sees no surface and no obstacle, and takes the surface as an empty plane at surface_height, in meters above the robot's base point (a table top, for example), the top of a block under it that stands from the front of the robot's body to the far end of the measured points, and reaches as far to each side of the robot as it reaches ahead. A surface_height that is not a finite number and one more than 1000 meters from the robot's base point are refused with rejected. It measures points from 0 to 1.0 m ahead of the robot and up to 0.30 m to either side. A point is reachable when an arm brings its grasp point within 0.01 m of a target 0.04 m above it with the gripper pointing straight down or straight forward, in a pose of which no part of the arm sinks into the block, in view when the perception camera sees it, and workable when it is both, or reachable alone for a robot whose view is not checked: one without a perception camera (perception_camera is then empty), or one whose perception camera has no camera geometry linked. Answers with frame, the robot frame, and no timestamp, since the bounds hold at every time; workable, true when the workable points cover at least 0.03 square meters; area, the workable part in square meters; rectangle, [x_min, x_max, y_min, y_max] in frame in meters, the largest rectangle the robot can work: put the items for a task inside it; reach and view, the bounds of the points an arm reaches and of those the camera sees, in the same form; and perception_camera, that camera's name, empty for a robot without one. A rectangle or bound that no point fills is absent. A robot that cannot read its perception camera's geometry now refuses with precondition_failed. Changes nothing.",
          operation: "read_only",
          // An answer reads the perception camera's geometry, up to 2 s per
          // read, and solves the arms' inverse kinematics over the grid.
          deadline_ms: 15000,
        },
        {
          member: "check_positions",
          tool: "robot.check_positions",
          description: "Learn whether the robot can work each of the given points, from the robot's design and the field of view of its perception camera, as robot.describe_workspace does. It knows nothing of the room: it checks no obstacle and nothing that could hide a point. frame and timestamp, by the frame rule, are those of every point, which the robot places in the robot frame; points holds the points, each a position [x, y, z] in meters, the target the grasp point would reach: give the points of brain.scan_items with the frame and the timestamp of its answer. An empty list, a value that is not a finite number, and a point that, placed in the robot frame, has a coordinate more than 1000 meters from the robot's base point are refused with rejected, and a frame or a time the robot cannot place with a kind of the frame rule. Answers with all_workable, whether the robot can work every point; perception_camera; and results, one per point in the request's order: the point as the robot placed it, frame, the robot frame, timestamp, the time of the robot frame's place it is in, left out when that place holds at every time, so a point sent back is placed at the same spot, and position; workable, reachable and in_view, as robot.describe_workspace defines them; arm, the arm that reaches it, by the name the limb tools take, empty when none does; short_by, how far in meters the closest arm's grasp point stops short of it whichever way the gripper points, 0 when an arm reaches it, and at most 0.01 with reachable false when the arms come that close but none reaches it with its gripper pointing down or forward; view, seen, outside_field, out_of_depth, or no_camera for a robot whose view is not checked; and message, one line that says why. A robot that cannot read its perception camera's geometry now refuses with precondition_failed. Changes nothing.",
          operation: "read_only",
          deadline_ms: 15000,
        },
      ],
    },

    // A robot's motion planner, where it has one: arm paths planned around
    // what the robot's depth camera has seen and the objects of its planning
    // scene, which robot.execute_joint_path then runs, and the scene itself.
    // A plan moves nothing.
    planner: {
      contract: {
        name: "motion_planning",
        tag: "v1",
        sha256: "381c6d4edbaded9a48e458198a5b3e852534523a50b6799b8899adda80e510d7",
      },
      actions: [
        {
          member: "plan_joint_path",
          tool: "planner.plan_joint_path",
          description: "Plan a path for one arm or both together to a goal, around the objects of the planning scene, what the robot's depth camera has seen, the robot's own body and the other arm, without moving anything. arms lists the arms, each once: arm_name, as robot.list reports it, and start_joint_positions, empty to start from where the arm stands. The goal is goal_joint_constraints, each a joint by the name planner.describe_arms gives with a target joint_position, tolerance_above and tolerance_below; and goal_position_constraints and goal_orientation_constraints, each a link by name with frame and timestamp, by the frame rule: its origin within tolerance_m of position, and its orientation within tolerance_rad of orientation, a unit quaternion [x, y, z, w], free to turn about its axis free_axis when that is x, y or z, none otherwise. Each constraint applies to the arm whose joint or link it names. A constraint in a link of an arm the plan moves, or in a link fixed to one, is held against that link: a goal constraint is met where that link stands in the path's last state, and a path constraint where it stands in each state, so a goal of one arm in the other arm's grasp_link moves with that link as the plan moves it. Every orientation is given whole, with its four entries. An arm's goal is its joints, or the position and orientation of one of its links; the two arms may take different kinds, and an arm whose constraints mix joints with poses, or name two of its links, is refused. An arm of arms that no goal constraint names stays where it starts, and a path constraint on it holds when its start lies within tolerance_rad. Pass an empty list for each kind the goal does not use. path_orientation_constraints holds orientations along the whole path, such as a carried cup kept upright, each a link by name with frame, timestamp, orientation, tolerance_rad and free_axis as in goal_orientation_constraints: every state of the path from the plan's start, its rounded corners included, holds each, in any order of the list; pass an empty list for none. A goal that names a position of a link and no orientation takes the orientation of that link's constraint here. planner is rrt_connect, which answers the first path RRTConnect finds, simplified in the time left, or rrt_star, which shortens its path's length, the sum of its joints' changes, until the time ends; refiner is none, or chomp, which refines the planner's path with CHOMP, all its iterations, past the time when need be, and answers the refined path, CHOMP's 101 points as a plan answers any path, less each that barely moves from the one kept before it, with the waypoints a repaired corner adds, when it keeps every rule and costs less than the planner's path in CHOMP's cost, its acceleration plus its nearness to obstacles, the planner's path otherwise; allowed_planning_time_s is the time the plan may take, more than 0 and at most 60, the simplifier's first pass, the refiner's iterations and the check of the path running to their end past it when the plan leaves them none; with 1 s, on a Jetson AGX Thor in front of an openarm_v2, an rrt_connect plan around a table answered a path 30 times in 30, of one arm within 1.0 s and of both arms within 1.7 s, rrt_star, which plans until the time ends, answered 100 detour scenes of one arm and 60 drawn scenes of both arms within 1.5 s, and chomp refined a path of one arm within 0.2 s and of both arms within 0.3 s; a goal few configurations meet, such as both hands past each other, or both arms at positions with no orientation, may need more, and a refusal that says the deadline ended the goal sampling asks for it. After the call, nothing has moved, and the result gives frame, the robot frame, and no timestamp, since the grasp-point poses follow from the joint positions alone, and, for each arm in the order of arms, start_joint_positions and as many waypoints as the other arm's, the arms passing their k-th waypoints together, each with the joint positions and the grasp-point position and orientation in frame: run them with robot.execute_joint_path, passing every arm of the result, each with its waypoints' joint_positions as its waypoints and its start_joint_positions as its expected_start_joint_positions. The plan fails with unreachable when no joint positions that meet the goal are free, with no_path when no path joins them or none keeps the path orientations, as when a start lies more than 0.99 of tolerance_rad from one or a goal farther from it than 0.9 of tolerance_rad or the start's own angle from it, whichever is more, and with start_in_collision when the start touches an obstacle or the robot's own body, or stands nearer than the clearance planner.get_planning_scene reports to the map or an object, the message naming the pair and what to do. It is refused with precondition_failed before the robot's joints are measured, when the start lies outside a joint limit by more than the planner's start tolerance, and, on a robot with a depth camera, before the planner's first depth frame, and with a kind of the frame rule for a constraint the planner cannot place. The plan does not check space the camera has not seen, such as under a table, which counts as free; on a robot with no depth_camera under members it keeps clear of the robot's own body and the objects of the planning scene only. On so101 a start folded onto itself as the arm rests is refused with start_in_collision: plan from robot.move_to_home; and with five joints its goal takes an orientation with slack: a tolerance_rad such as 0.1, or a free_axis. robot.execute_joint_path may still refuse a planned path with unreachable, its guard keeping margins of its own.",
          operation: "long_running",
          // The planning time a goal admits, 60 s, which bounds the search,
          // and 5 s for the simplifier's first pass, the refiner's iterations
          // and the check of the path that run past it: on a Jetson AGX Thor, a
          // plan of both arms answered at most 665 ms past a 1 s time and at
          // most 1.6 s past a 0.5 s time, and every `rrt_connect` plan of the
          // libraries' drawn scenes answered at most 1.0 s past its time on
          // amd64. On that Jetson a plan that holds path orientations answered
          // at most 172 ms past a 1 s time and at most 599 ms past a 0.5 s time,
          // over 100 drawn scenes of each of five sets. On that Jetson an
          // `rrt_star` plan answered at most 457 ms past a 1 s time and a plan
          // refined by `chomp` at most 683 ms past it, over 100 detour scenes of
          // one arm and 60 drawn scenes of both arms.
          deadline_ms: 65000,
        },
        {
          member: "plan_cartesian_path",
          tool: "planner.plan_cartesian_path",
          description: "Compute a path along which one link of an arm follows straight lines through poses, around the objects of the planning scene, what the robot's depth camera has seen and the robot's own body, without moving anything. arm_name is the arm, as robot.list reports it; start_joint_positions, empty to start from where the arm stands; link_name, the link that follows the lines, by the name planner.describe_arms gives: the arm's grasp_link, or a link fixed to it; frame and timestamp, by the frame rule, of every waypoint; waypoints, the poses of link_name to pass through, each a position and an orientation, a unit quaternion [x, y, z, w]. A waypoint in a link of the arm is placed where that link stands at the path's start. The link's orientation turns the shorter way in step with its position, within 1 mm and 0.01 rad at every state. With avoid_collisions false, no collision is checked and no depth frame is needed: a test of reach and precision alone, such as whether an obstacle is what blocks a path. After the call, nothing has moved, and the result gives frame and timestamp, as planner.plan_joint_path gives them; start_joint_positions; waypoints, as much of the path as is valid, each with joint_positions and the arm's grasp-point position and orientation in frame; and fraction, the share of the path covered from 0 to 1, each line counting equally. A fraction below 1 means the path ends before a pose the arm cannot reach, that collides, or past which the precision cannot be kept. To move, run the waypoints with robot.execute_joint_path, passing start_joint_positions as its expected_start_joint_positions. With avoid_collisions true, a start in contact, or nearer than the clearance planner.get_planning_scene reports to the map or an object, fails with start_in_collision, the message naming the pair and what to do; from a start nearer than it within the robot's own body, the path leaves in one straight joint run to the first state that keeps it; and planner.set_allowed_collision lets a held object or the fingers touch what they touch. No waypoints, or any other link, such as an inner link or a finger, are refused with rejected: name the grasp_link. Waypoints the planner cannot place are refused with a kind of the frame rule. It is refused with precondition_failed before the robot's joints are measured, when the start lies outside a joint limit by more than the planner's start tolerance, and, with avoid_collisions true on a robot with a depth camera, before the planner's first depth frame. It does not check space the camera has not seen, such as under a table, which counts as free. A five-joint arm such as so101 holds few orientations along a line, so its path ends before a pose whose orientation it cannot hold.",
          operation: "long_running",
          // As planner.check_joint_path: a path holds no time limit of its own,
          // and the longest of 400 drawn paths, 30 cm lines, took 109 ms on
          // amd64, about 0.2 s on a Jetson AGX Thor at its 1.8 times amd64's
          // plan time, so 15 s runs paths of many lines; a cancel ends a longer
          // one.
          deadline_ms: 15000,
        },
      ],
      services: [
        {
          member: "check_joint_path",
          tool: "planner.check_joint_path",
          description: "Check the path robot.execute_joint_path would run for one arm or both together, against the objects of the planning scene, what the robot's depth camera has seen, the robot's own body, the other arm and the joint limits, as a plan is checked. arms lists the arms, each once: arm_name, start_joint_positions, empty for where the arm stands, and waypoints, each with joint_positions, as many for each arm. clear is true when the whole path passes; clear_waypoints is the most waypoints, from the first, whose path, the arms run through them together, passes; reason says what fails and how close it comes. A check while the planner cannot place an object of the scene in the robot frame is refused with a kind of the frame rule. Changes nothing.",
          operation: "read_only",
          deadline_ms: 15000,
        },
        {
          member: "describe_arms",
          tool: "planner.describe_arms",
          description: "Report each arm: its name, its gripper, its joints in the order of a waypoint with their lower and upper limits, its links, its grasp link and the axes of that link along which the gripper approaches an item and closes, and the gripper's links, which a held object may touch; and the robot's links outside its arms. These are the names that planner.plan_joint_path's constraints and the planning scene take. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "clear_occupancy_map",
          tool: "planner.clear_occupancy_map",
          description: "Empty the planner's map of what the robot's depth camera has seen, such as after a table moved away. After the call, the map holds nothing, the depth frames that follow fill it again, and, on a robot with a depth camera, planner.plan_joint_path and planner.check_joint_path are refused with precondition_failed until the next frame.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "apply_collision_objects",
          tool: "planner.apply_collision_objects",
          description: "Add, move or remove objects of the planner's planning scene, which planner.plan_joint_path and planner.check_joint_path keep clear of, such as a table top or an item the brain found. objects is a list applied in order, all or none; each has id, operation (add, move or remove), frame and timestamp, by the frame rule, position and orientation, the object's pose, which the planner places when it takes the call in the root of its frame's chain, the frame that holds still across a move of the robot (odom or map on a mobile base, the robot frame on a fixed one), and holds there, and shapes. Each shape has kind (box, sphere, cylinder or mesh); dimensions, a box's full side lengths x, y, z, a sphere's radius, or a cylinder's height along z then its radius, empty for a mesh; mesh_vertices, each vertex a position [x, y, z] in meters, and mesh_triangles, three 0-based vertex indices per triangle, closing a solid with each edge bordering exactly two triangles, both empty for a box, sphere or cylinder; and its own position and orientation, relative to its object's pose. add replaces an object of the same id and keeps its allowed pairs; move reads only id, frame, timestamp, position and orientation; remove reads only id and drops every allowed pair that names the object. Leave out the fields an operation does not read. An empty list changes nothing. An empty id, an id equal to a link name or to occupancy_map, an unknown id for move or remove, an attached object, an add or a move with no position or orientation, an add with no shapes, and an open mesh are refused with rejected, an object the planner cannot place with a kind of the frame rule, and the scene stays as it was. A depth point within the padding the planner grows an object by marks nothing, so an item smaller than that resting on an object is avoided only when it is added as an object of its own. After the call, the scene holds the objects as the list left them, and the cubes of the map that each object the list added or moved intersects where the list left it are empty. Each large object the list adds or moves can take up to about 0.9 s; a call that passes its deadline answers timeout while the scene still takes the change, so read planner.get_planning_scene after one.",
          operation: "mutating",
          // An object's apply clears its cubes; the slowest measured is a 1 m box,
          // turned, whose bounds fill most of the launch map (1.32 x 1.64 x 1.32 m,
          // 2 cm cubes): 332 to 510 ms on the laptop, the slower on a loaded machine.
          // On a Jetson AGX Thor it comes to about 0.9 s by estimate: 510 ms times 1.8,
          // the Jetson's slowest arm-planning parity plan over the laptop's (921.9 ms
          // to 514.9 ms). A 9,800-triangle 1 m mesh took 33 to 41 ms.
          // A call clears its objects one after the other, so 2 s covers two such
          // objects; the tool text says so.
          deadline_ms: 2000,
        },
        {
          member: "apply_attached_collision_object",
          tool: "planner.apply_attached_collision_object",
          description: "Attach an object of the planning scene to an arm's grasp link where it stands, such as an item just grasped, or detach it where it stands. object_id names the object; link_name is a grasp_link that planner.describe_arms reports; touch_links lists the robot's links that may touch it, such as the gripper's links; operation is attach or detach, and detach reads only object_id. An attached object moves with its link; plans keep it out of contact with the other links of its arm and clearance_m from everything else, and never check it against its link, its touch_links or the other objects that arm holds. A link_name that is not a grasp_link, an unknown object_id, a touch link the robot does not have or that names an object, attaching an attached object, and detaching one that is not attached are refused with rejected, an attach before the robot's joints are measured with precondition_failed, and a call whose object the planner cannot place with a kind of the frame rule. After the call, planner.get_planning_scene lists the object under attached_objects when it is attached, and under objects where it was detached, with its allowed pairs kept.",
          operation: "mutating",
          // An attach clears the object's cubes as an add does: see apply_collision_objects.
          deadline_ms: 2000,
        },
        {
          member: "set_allowed_collision",
          tool: "planner.set_allowed_collision",
          description: "Let an object of the planning scene, attached or not, touch each of other_names, or stop it, such as a block set down on a table or closed in the fingers. name is the object; other_names are links as planner.describe_arms names them, other objects, or occupancy_map for the map of what the depth camera has seen; allowed is true to allow and false to stop. A pair is unordered, an allowed pair is never checked, and an empty other_names changes nothing. To set a held block down on a table, allow the block with the table, and the table with the gripper's links when they come nearer to it than clearance_m. A name that is not an object of the scene, and other_names holding name itself, are refused with rejected. After the call, planner.get_planning_scene lists the allowed pairs; they stay through attach, detach, move and a replacing add, and removing an object drops every pair that names it.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "get_planning_scene",
          tool: "planner.get_planning_scene",
          description: "Report the planning scene: frame, the robot frame, and timestamp, the time of the answer; objects, those no link carries, each with id, its pose in frame and its shapes, each shape posed relative to its object; attached_objects, each with id, frame, the link that carries it, its touch_links, its pose in that frame and its shapes; allowed_pairs, each pair once; clearance_m, the clearance each planned state keeps from the map, the objects and the robot's own body, and an attached object from all but its own arm and the objects that arm holds; and voxel_size_m, the side of the map's cubes. A read while the planner cannot place an object in the robot frame is refused with a kind of the frame rule. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
      ],
    },

    // A robot's navigator, where it has one: the moves of its mobile base
    // that keep clear of what the robot's sensors see, a navigation to a pose
    // around them, a turn in place and a straight drive ahead or back, and
    // the clearing of the grid it keeps of the floor. Each action becomes a
    // tool that runs as a task for a client that declares the tasks
    // extension, and inside the call for any other.
    navigator: {
      contract: {
        name: "base_navigation",
        tag: "v1",
        sha256: "3e28db1f92c694f1895fa4160a69f7d7764a3346c0ab1c033a4f65b27ffbcf40",
      },
      actions: [
        {
          member: "navigate_to_pose",
          tool: "navigator.navigate_to_pose",
          description: "Drive the robot's mobile base to a pose, around the obstacles its sensors see, and bring it to rest there. target is the pose to drive the robot frame to: frame and timestamp, which the robot places by the frame rule when it takes the goal, position [x, y, z] in meters and orientation a unit quaternion [x, y, z, w]. A target in any frame but map is placed in odom, and the navigation runs in odom: there the position's z is 0, the orientation turns about +z alone, [0, 0, sin(yaw/2), cos(yaw/2)] for a yaw counterclockwise seen from above, and the target lies inside the navigator's grid of the floor, a square centered on the base. A target in the robot frame with no timestamp names a pose from where the robot stands when it takes the goal: position [1.5, 0, 0] with orientation [0, 0, 0, 1] drives 1.5 m ahead. A target in map runs in map, on the navigator's loaded map. position_tolerance_m and orientation_tolerance_rad say how close the robot frame must come to the target: the navigation reaches the goal once the robot frame's origin stands within position_tolerance_m of it, with the path left to it at most the navigator's path length tolerance, and then its heading within orientation_tolerance_rad of the target's, pi or more leaving the heading free. max_speed_m_s is the fastest the base may move in m/s, 0 for the base's own limits, and otherwise at least the deadband along x and at most the larger magnitude of the min_velocity and max_velocity along x that robot.describe_base reports in linear_limits. The navigator's sensors are one or more depth cameras fixed to the base, none that an arm or another part carries: an obstacle is what they see from above the floor up to at least the robot's height, or a drop in the floor deeper than the navigator's step, within the navigator's obstacle range of each sensor along the floor, and a place no sensor has seen counts as free. The navigator plans a path around the obstacles, follows it, plans again as the sensors see more, and slows and stops the base before an obstacle ahead and before a drop. The base drives forward and turns, never sideways, and backward only in a back-up. When a try fails, the navigator runs its recoveries in this order, each at most once in a navigation: it empties its grid, turns in place counterclockwise, waits, and backs up, trying again after each of the first three, and the navigation fails after the back-up. A navigation keeps the base's footprint, padded, clear of the obstacles, and keeps no part outside the footprint clear, such as an outstretched arm: it moves the base only while every limb stands within the footprint, as robot.base_state reports in parts_within_footprint. While it runs, its progress gives, at each step of the navigator's controller and at least once a second, current_pose, where the robot frame stands in the frame the navigation runs in, distance_remaining_m along the planned path, angle_remaining_rad, estimated_time_remaining_s and recoveries, the clearings, turns, waits and back-ups it has started. A call is checked in this order: before the base first reports, and before the navigator has read robot.describe_base since the base's odometry started, a call waits up to the navigator's source timeout, and is refused with resource_unavailable when that read fails or the timeout passes, or when the base is one the navigator cannot drive, the message saying why, and with precondition_failed when the base's odometry_source is commanded; a value it does not take is refused with rejected: an orientation that is not a unit quaternion, a tolerance that is not above 0, a max_speed_m_s outside its range, a value that is not finite, and a target in map off the floor's plane or outside the loaded map; a target in map, with not_localized while no map is loaded or the base is not localized in it, the message saying that no map is loaded and to send the target in odom or the robot frame; a target in another frame that the robot cannot place in odom, with a kind of the frame rule; a target that, placed in odom, has a z farther than 1e-9 m from 0, turns by more than 1e-9 rad about an axis other than +z, or lies outside the grid centered on the base, with rejected, the message naming the part, its value in odom and what to send; while the base's motion sensing is silent, once its newest measurement is more than 0.5 s old, while a silence of the base's motion sensing still holds the base after the base reports again, or while no reading of a sensor of the navigator went into its grid within its source timeout, with resource_unavailable, the message naming what the navigator waits for, each silent sensor by name; while the base's mode holds the base, from a mode on robot.base_state other than standing and moving until just after the mode returns to one of them, with precondition_failed, the message naming the mode and, while the mode is neither standing nor moving, what brings the base to standing; while a limb stands outside the footprint, with precondition_failed, the message naming robot.move_to_home; while a leader that the navigator follows streams to it, with leader_streaming; and while robot.stop or a move of the robot's own, such as robot.move_base, holds the base, with precondition_failed. The message of a refusal for robot.stop, for a silence of the base's motion sensing, or for the base's mode while it is standing or moving says to send the goal again more than 0.6 s after the refusal. The navigation fails, the base coming to rest: with start_in_collision when the base stands in collision with an obstacle, before it moves or when a plan finds it so, and with unreachable when the goal does; with no_path when no path joins the base to the goal after the recoveries, and with blocked when the base found no way forward after them; with resource_unavailable when a sensor falls silent, when the base's odometry starts over and when the base's motion sensing falls silent; and with attempt_failed when the base's mode leaves standing and moving, when a limb leaves the footprint, and for another cause. One goal of the navigator runs at a time: a goal of any navigator. tool replaces the one that runs, which ends cancelled with a reason that says a new goal replaced it, its result giving where the robot frame stood when the robot took the new goal, and the base slows from then until the new goal's first command drives it on; a refused goal leaves the running one as it was. A call that its caller cancels, or that robot.stop ends, ends cancelled, the base coming to rest. After the call, the base comes to rest, unless a new navigator goal replaced the navigation and drives the base on. The result of a completed or cancelled navigation gives final_pose, where the robot frame stood when the navigation ended, in the frame it ran in: frame, timestamp, the time of that pose, position [x, y, z] in meters and orientation, a unit quaternion [x, y, z, w]; distance_driven_m, the length of the way the base drove by its odometry; and action_time, how long the call took in seconds. A navigation completes once it reaches the goal, and its final_pose is where the robot frame stood then; the base comes to rest after it, and can rest outside the tolerances by the distance it covers while it slows.",
          operation: "long_running",
          safety_sensitive: true,
          // A navigation has no bound on its length, so it is bounded by its
          // progress, which the navigator reports at each step of its
          // controller and at least once a second: the call fails only when a
          // whole minute passes with no progress message, and the goal, which
          // moves the robot, runs on to its end.
          progress_timeout_ms: 60000,
        },
        {
          member: "spin",
          tool: "navigator.spin",
          description: "Turn the robot's mobile base in place by an angle, keeping its padded footprint clear of the obstacles its sensors see, and bring it to rest. angle_rad is the turn in radians, counterclockwise seen from above positive and clockwise negative, any finite angle; beyond a full turn the base turns more than once. timeout_s is how long in seconds from when the robot takes the goal the base has to turn the whole angle before the spin fails with timeout, 0 or above, 0 for no bound. The spin turns from where the robot frame stands when the robot takes the goal, in odom, by the base's odometry: at each step of the navigator's controller it turns at the rate from which the max_deceleration of angular_limits brings the base to rest at the end of the turn, at least the larger of the navigator's slowest turn rate and the deadband of angular_limits, and at most max_rate counterclockwise and the magnitude of min_rate clockwise, as robot.describe_base reports them. It sweeps the padded footprint ahead of the turn, turned at that rate step by step up to the navigator's simulate-ahead time and to less than the turn made so far, and fails with blocked when the sweep meets an obstacle, the base then coming to rest. While the spin runs, its progress gives angle_turned_rad, the angle the robot frame has turned since the robot took the goal, by the odometry, counterclockwise positive and summed over the turn, so its magnitude can exceed pi. Once the odometry measures the whole turn, the spin completes, and the base then comes to rest. A call is checked as navigator.navigate_to_pose checks one, with no target to place, and refused with rejected for an angle_rad above 0 while the max_rate of angular_limits is 0, or below 0 while its min_rate is 0, for a timeout_s below 0 and for a value that is not finite. The spin fails, the base coming to rest, with blocked and with timeout as above, and with resource_unavailable and attempt_failed as navigator.navigate_to_pose fails with them, and it replaces the navigator's goal that runs, as navigator.navigate_to_pose says. A call that its caller cancels, or that robot.stop ends, ends cancelled, the base coming to rest. After the call, the base comes to rest, unless a new navigator goal replaced the spin and drives the base on; after a completed spin, it can come to rest beyond angle_rad by the turn it makes while it slows. The result of a completed or cancelled spin gives final_pose, where the robot frame stood in odom when the spin ended: frame, odom, timestamp, the time of that pose, position [x, y, 0] in meters and orientation, a unit quaternion that turns about +z alone; and action_time, how long the call took in seconds.",
          operation: "long_running",
          safety_sensitive: true,
          // As navigate_to_pose: a timeout_s of 0 sets no bound.
          progress_timeout_ms: 60000,
        },
        {
          member: "drive_on_heading",
          tool: "navigator.drive_on_heading",
          description: "Drive the robot's mobile base straight ahead along the robot frame's +X by a distance, keeping its padded footprint clear of the obstacles its sensors see, and bring it to rest. distance_m is how far in meters the robot frame's origin drives, above 0, its end inside the navigator's grid of the floor, a square centered on the base. speed_m_s is the speed to drive at in m/s, above 0, at least the deadband along x and at most the max_velocity along x that robot.describe_base reports in linear_limits. timeout_s is how long in seconds from when the robot takes the goal the base has to cover the distance before the drive fails with timeout, 0 or above, 0 for no bound. The drive starts where the robot frame stands when the robot takes the goal, in odom, and covers its distance once the base's odometry places the robot frame's origin that far from where it started. At each step of the navigator's controller it commands speed_m_s, ramped up from 0 at its first step by at most the max_acceleration along x of linear_limits times the step's period at each step, less where the max_deceleration along x of linear_limits must bring the base to rest at its distance, at least the larger of the navigator's slowest forward speed and the deadband. It sweeps the padded footprint ahead of the base along its heading at the commanded speed, step by step up to the navigator's simulate-ahead time and to less than the distance left, and fails with blocked when the sweep meets an obstacle, the base then coming to rest. While the drive runs, its progress gives distance_traveled_m, how far the robot frame's origin stands from where it stood when the robot took the goal, by the odometry. Once the odometry measures the whole distance, the drive completes, and the base then comes to rest. A call is checked as navigator.navigate_to_pose checks one, with no target to place, and refused with rejected for a distance_m that is not above 0 or whose end lies outside the grid, a speed_m_s that is not above 0 or lies outside its range, a timeout_s below 0 and a value that is not finite. The drive fails, the base coming to rest, with blocked and with timeout as above, and with resource_unavailable and attempt_failed as navigator.navigate_to_pose fails with them, and it replaces the navigator's goal that runs, as navigator.navigate_to_pose says. A call that its caller cancels, or that robot.stop ends, ends cancelled, the base coming to rest. After the call, the base comes to rest, unless a new navigator goal replaced the drive and drives the base on; after a completed drive, it can come to rest beyond distance_m by the distance it covers while it slows. The result of a completed or cancelled drive gives final_pose, where the robot frame stood in odom when the drive ended: frame, odom, timestamp, the time of that pose, position [x, y, 0] in meters and orientation, a unit quaternion that turns about +z alone; and action_time, how long the call took in seconds.",
          operation: "long_running",
          safety_sensitive: true,
          // As spin.
          progress_timeout_ms: 60000,
        },
        {
          member: "back_up",
          tool: "navigator.back_up",
          description: "Drive the robot's mobile base straight back along the robot frame's -X by a distance, as navigator.drive_on_heading drives it ahead, and bring it to rest. distance_m, timeout_s, the checks, the sweep, the progress, the endings and the result are those of navigator.drive_on_heading, backward: the end of distance_m lies behind the base inside the navigator's grid, and the sweep runs behind the base. speed_m_s is the speed to drive at in m/s, above 0, at least the deadband along x and at most the magnitude of the min_velocity along x that robot.describe_base reports in linear_limits, so a base whose min_velocity along x is 0 refuses every back_up with rejected; the drive commands at least the navigator's slowest backward speed. A call that its caller cancels, or that robot.stop ends, ends cancelled, the base coming to rest. After the call, the base comes to rest, unless a new navigator goal replaced the back-up and drives the base on; after a completed back-up, it can come to rest beyond distance_m by the distance it covers while it slows. The result of a completed or cancelled back-up gives final_pose, where the robot frame stood in odom when the back-up ended, and action_time, as navigator.drive_on_heading gives them.",
          operation: "long_running",
          safety_sensitive: true,
          // As spin.
          progress_timeout_ms: 60000,
        },
      ],
      services: [
        {
          member: "clear_grid",
          tool: "navigator.clear_grid",
          description: "Empty the navigator's grid of the floor, such as after a box was carried away: every place counts as never seen. After the call, the sensors mark again what they see, a navigation in flight plans on what they see from then on, and a navigation in map keeps the places its loaded map holds occupied. It answers with an error, attempt_failed, only when the clearing itself cannot be carried out. Takes no arguments and moves nothing.",
          operation: "mutating",
          deadline_ms: 2000,
        },
      ],
    },

    // The maps of the rooms a mobile base drives in and the base's place in
    // them, where the base carries a 2-D lidar: its room mapper answers the
    // map state, the saved maps and the base's localization on demand, and
    // streams the base's pose in the loaded map as a resource per robot. No
    // member moves the base.
    room_map: {
      contract: {
        name: "room_map",
        tag: "v1",
        sha256: "9662921bf1cb40a4d6afbbc78b0b2cd90ded835f97bb95255197aed1d4f48d5d",
      },
      topics: [
        {
          member: "map_poses",
          resource: "navigator.map_pose",
          description: "Where the robot frame stands in the loaded map, as AMCL's amcl_pose gives it, one message per lidar scan the navigator takes while it has an estimate, none otherwise: frame, map; timestamp, the time of the scan the estimate is carried to; map_name, the loaded map; position [x, y, 0] in meters and orientation, a unit quaternion that turns about +z alone, the estimate carried by the base's odometry to that scan, given also while the base is not localized; position_std_m, the standard deviation of the position along its least certain direction in meters, and orientation_std_rad, that of the heading in radians, both of the newest update of the estimate; and localized, true while the base is localized, by the map rule. The estimate updates as the base moves and the lidar sees, so updates can pause while the base stands still, and the pose then holds. The resource goes stale 2 s after its last pose: while the lidar is silent, and while the navigator has no estimate, as after navigator.load_map until navigator.set_initial_pose matches.",
          // One pose per scan the mapper takes: none for 2 s means the lidar
          // went quiet or the mapper has no estimate.
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 5 },
          // The frame and the map's name are strings, so the runtime size
          // policy is mandatory; a map pose is small, its map name at most 64
          // characters, and one that is not is a fault to refuse.
          max_result_bytes: 4096,
          on_oversize: "reject",
        },
      ],
      services: [
        {
          member: "get_map_state",
          tool: "navigator.get_map_state",
          description: "Report the navigator's map state, whatever it is doing. map is the loaded map, absent while none is loaded: map_name, the name it is saved under; cell_size_m, the side of a cell of its grid in meters; extent, [x_min, x_max, y_min, y_max] in meters, the rectangle of the map frame its grid covers, which grows while mapping runs and is absent while a new map's mapping has read no scan; scans, the lidar scans that arrived after navigator.start_mapping and that its mapping read, whether or not each changed the map; and mapping_start_timestamp, when its mapping started, on the wall clock of the navigator's machine. mapping is true while mapping runs, searching while a search of navigator.reinitialize_global_localization runs, waiting while a navigator.set_initial_pose waits for its scan, and localized while the base is localized in the loaded map, by the map rule. A pose lies inside the map when its position lies inside extent. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "start_mapping",
          tool: "navigator.start_mapping",
          description: "Start a new map named map_name, a map name by the map rule: its map frame is odom as it stands now, the new map becomes the loaded map, and a running search ends. After the call, mapping runs, the base is localized in the new map while it runs, and the map's grid holds what the lidar sees as the base drives: drive the base around the room with robot.move_base or robot.drive_base to map it, then save the map with navigator.finish_mapping. It waits for the map rule's read of the base's odometry_source, then is refused with rejected for a name that is not a map name or that a saved map has; with precondition_failed while mapping runs, while a navigator.set_initial_pose waits, and while robot.describe_base names commanded odometry; and with resource_unavailable while more than 0.5 s have passed since the base's newest state reached the navigator, and while the lidar is silent, no scan of it taken within the navigator's source timeout. Starts no motion.",
          operation: "mutating",
          // A call waits for the read of the base's odometry_source up to the
          // room mapper's source_timeout_s, 2 s at the simulated base's
          // launch, then answers within the 2 s of the endpoint's quick calls:
          // 2 + 2 = 4 s.
          deadline_ms: 4000,
        },
        {
          member: "finish_mapping",
          tool: "navigator.finish_mapping",
          description: "End mapping and save the loaded map under its name. After the call, the saved map stays the loaded map, the navigator's estimate goes on from mapping's, and the base is localized while that estimate's deviations lie within the matching's limits, by the map rule. It answers with map, the saved map, as navigator.get_map_state describes it. Refused with precondition_failed while mapping does not run. Fails with attempt_failed, the message naming the cause, when the map holds no scan or cannot be saved; mapping then goes on. Starts no motion.",
          operation: "mutating",
          // As the endpoint's quick calls: the B8 e2e measured 22 ms.
          deadline_ms: 2000,
        },
        {
          member: "list_maps",
          tool: "navigator.list_maps",
          description: "List every saved map whose description the navigator can read, sorted by name, each as navigator.get_map_state describes a map. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "remove_map",
          tool: "navigator.remove_map",
          description: "Remove the saved map map_name. After the call, navigator.list_maps does not give it and navigator.start_mapping takes its name, to map the room again; when it was the loaded map, no map is loaded, the navigator has no estimate, and a running search has ended. Refused with rejected for a name no saved map has, and with precondition_failed for the loaded map while a navigator.set_initial_pose waits. Starts no motion.",
          operation: "mutating",
          deadline_ms: 2000,
        },
        {
          member: "load_map",
          tool: "navigator.load_map",
          description: "Load the saved map map_name as the loaded map, and end a running search. After the call, the navigator has no estimate in it, so the base is not localized and navigator.map_pose gives no new pose, until navigator.set_initial_pose matches or navigator.reinitialize_global_localization starts a search. It answers with map, the loaded map, as navigator.get_map_state describes it. Refused with rejected for a name no saved map has, and with precondition_failed while mapping runs and while a navigator.set_initial_pose waits. Fails with attempt_failed, the message naming the cause, when the saved map cannot be read; the loaded map and the estimate then stay as they were. Starts no motion.",
          operation: "mutating",
          // As the endpoint's quick calls: the B8 e2e measured 16 ms.
          deadline_ms: 2000,
        },
        {
          member: "set_initial_pose",
          tool: "navigator.set_initial_pose",
          description: "Tell the navigator where the robot frame stands in the loaded map, and how far from that pose to search. target is that pose: frame, map, the one frame it takes, and timestamp, by the frame rule, left out for the time of the call; position [x, y, 0] in meters and orientation [0, 0, sin(yaw/2), cos(yaw/2)], a unit quaternion that turns about +z alone, by any finite angle. search_radius_m is how far in meters from the target's position the match searches for the robot frame's origin, and search_angle_rad how far in radians from its heading, pi or more searching every heading. The navigator carries target by the base's odometry from its timestamp, or from the call, to the first lidar scan after the call, and finds the best match of that scan against the map within search_radius_m and search_angle_rad of target. After the call, when that match's pose lies within them and its standard deviations within the matching's limits, the estimate is that pose, the base is localized and a running search has ended, and the call answers with current_pose, where the match places the robot frame: frame, map; timestamp, the scan's time; position [x, y, 0] in meters and orientation, a unit quaternion that turns about +z alone. The answered pose always lies within search_radius_m and search_angle_rad of target. Otherwise the call fails and the estimate stays as it was: with no_match when no match within them is that certain; with extrapolation when the base's odometry of that scan holds no state at or before target's timestamp or none at or after it; with resource_unavailable when the navigator takes no scan in the odometry the call was made in within its source timeout; and with attempt_failed, the message naming the cause, when the scan does not read as the map's scans do. In a room where no place looks like another, a robot frame that stands farther from target than search_radius_m or search_angle_rad plus the navigator's matching reach gets no_match; in a room whose places look alike, a match can lie at a place that looks like the robot frame's own. It waits for the map rule's read of the base's odometry_source, then is refused with rejected for a target in a frame other than map, a position outside the loaded map's extent while a map is loaded, a search_radius_m or a search_angle_rad that is not positive, a number that is not finite, an orientation the frame rule refuses, and a target whose position has a z farther than 1e-9 m from 0 or whose orientation turns by more than 1e-9 rad about an axis other than +z, the message naming the part and what to send, a position [x, y, 0] and an orientation [0, 0, sin(yaw/2), cos(yaw/2)]; with precondition_failed while no map is loaded, while mapping runs, and while robot.describe_base names commanded odometry; and with resource_unavailable while more than 0.5 s have passed since the base's newest state reached the navigator. A call made while another waits waits for that one to answer, then runs. Starts no motion.",
          operation: "mutating",
          // A call made while another waits runs once that one answered, so
          // the deadline covers the wait for the read of the base's
          // odometry_source and two calls, each waiting for its scan and
          // matching it. The room mapper's source_timeout_s, 2 s at the
          // simulated base's launch, bounds the wait for the read and for a
          // scan, and the slowest match the B8 e2e measured over its runs is
          // 0.259 s: 2 + 2 x (2 + 0.259) = 6.518 s, up to a whole second.
          deadline_ms: 7000,
        },
        {
          member: "reinitialize_global_localization",
          tool: "navigator.reinitialize_global_localization",
          description: "Start a search of the whole loaded map for where the robot frame stands: the estimate becomes the search's, spread over the whole map, and a call while a search runs starts it over. It answers at once. After the call, the base is not localized until the search narrows within the search's limits, which it does as the base moves and the lidar sees more: turn the base in place or drive it, with robot.drive_base or robot.move_base, and read navigator.get_map_state or the navigator.map_pose resource until it reports localized true. The search runs until the base is localized, until navigator.set_initial_pose matches or navigator.load_map, navigator.start_mapping or a navigator.remove_map of the loaded map ends it, or until no scan arrives within the navigator's source timeout, which leaves the estimate where its last update placed it, carried by the base's odometry alone, and the base not localized until navigator.set_initial_pose matches or another search localizes it; navigator.get_map_state reports it in searching. It waits for the map rule's read of the base's odometry_source, then is refused with precondition_failed while no map is loaded, while mapping runs, while a navigator.set_initial_pose waits, and while robot.describe_base names commanded odometry. Fails with attempt_failed, the message naming the cause, when the loaded map's grid holds no free cell. Starts no motion.",
          operation: "mutating",
          // A call waits for the read of the base's odometry_source up to the
          // room mapper's source_timeout_s, 2 s at the simulated base's
          // launch, then answers within the 2 s of the endpoint's quick calls:
          // 2 + 2 = 4 s.
          deadline_ms: 4000,
        },
      ],
      // `map_grids` is live on the room mapper and absent here: its message
      // names no encoding, so no representation renders the grid as a
      // picture, and as JSON its cells, columns times rows of them, grow with
      // the room with no bound.
    },

    // A robot's brain, where it has one: the item scan and search, and the
    // manipulation sequences, on that robot's own arms. Each robot has its
    // own brain, so a brain tool names its robot like every other call.
    item_perception: {
      contract: {
        name: "item_perception",
        tag: "v1",
        sha256: "f15ced95fefbb8af04bc7538b4e5dff895af009003530dc590018318c3094f69",
      },
      actions: [
        {
          member: "scan_items",
          tool: "brain.scan_items",
          description: "Look at the scene through the robot's brain and report every item it can act on, minting an item_id for each. This is the robot's own answer to \"what do you see\": what it reports here is what it can identify and grab, so ask it rather than reading a camera picture, which is for a person. timeout_s bounds the scan in seconds, 0 for the robot's default. Returns frame, the robot frame, and timestamp, the capture time of the picture the robot looked at, at which it gives every point; and index-aligned arrays: item_ids, labels in the robot's own vocabulary (two items of one kind share a label and have distinct ids), points, each item's position [x, y, z] in meters in frame at timestamp, confidences from 0 to 1, and regions, 4 entries per item (x0, y0, x1, y1 in pixels, x to the right and y down, four zeros for an item this look did not see) of the picture depth_camera.look gives for the camera named in camera, an image of image_width by image_height captured at timestamp. An empty scene completes the scan with empty arrays. A scan is refused with precondition_failed while another scan or search runs, and with resource_unavailable when no perception source is available, and it fails with timeout when its bound passes before it has an answer. Scanning again keeps the id of an item the robot recognizes. Starts no motion. Its progress gives each stage of the scan as it starts, with one sentence of what the robot does then.",
          operation: "long_running",
          deadline_ms: 30000,
        },
        {
          member: "identify_item",
          tool: "brain.identify_item",
          description: "Find one item through the robot's brain and mint an item_id for it. This is the robot's own answer to \"is there a banana\" or \"where is the mug\": ask it rather than judging from a camera picture, since only an item it identifies here can be grabbed. description is the item's name in a few plain words, such as \"apple\" or \"red mug\": no article, no sentence, no position (\"the mug on the left\" becomes \"red mug\"); empty for the most prominent item the robot can act on. To choose between several items of the same kind, call brain.scan_items and pick the item by its point. timeout_s bounds the search in seconds, 0 for the robot's default. Returns item_id, a label in the robot's own vocabulary, item_point, where the item is, absent after a cancel: frame, the robot frame, timestamp, the capture time of the picture the robot looked at, and position in meters; item_pose, the same with orientation, only when the robot resolved how the item is turned; confidence from 0 to 1, and region, the item's x0, y0, x1, y1 in pixels of the picture depth_camera.look gives for the camera named in camera, an image of image_width by image_height captured at that timestamp. Its refusals and its timeout are those of brain.scan_items, and a search that finds no item that matches fails with not_found. Starts no motion. Its progress gives each stage of the search as it starts, with one sentence of what the robot does then.",
          operation: "long_running",
          deadline_ms: 30000,
        },
      ],
    },

    item_manipulation: {
      contract: {
        name: "item_manipulation",
        tag: "v1",
        sha256: "61d71f86ca1caaf1de4d6bde92c01315761da3ceb5a64a546698538d63c8778c",
      },
      actions: [
        {
          member: "grab_item",
          tool: "brain.grab_item",
          description: "Close one of the robot's grippers on an item. gripper_name is one of the names brain.get_state reports for the robot, or empty to let it pick a free gripper suited to the item. Give item_id from brain.identify_item or brain.scan_items, with a target of position [0, 0, 0] alone, with no frame, timestamp or orientation; or leave item_id empty and give target, the grasp-point pose: frame and timestamp, which the robot places by the frame rule, position in meters, and orientation, left out to let the robot choose the approach. max_effort caps the grip in the gripper's effort unit, 0 for the default. Refused when the gripper is unknown or already holds an item, when no gripper is free, or when item_id is one the robot no longer recognizes, and with a kind of the frame rule for a target the robot cannot place. Returns the gripper_name and item_id now held; the robot reports it is holding the item from then on. Its progress gives each stage of the grab as it starts, with one sentence of what the robot does then.",
          operation: "long_running",
          safety_sensitive: true,
          // A reach, a close, and a check: several lower level moves in
          // sequence, so the deadline covers the whole sequence.
          deadline_ms: 120000,
        },
        {
          member: "drop_item",
          tool: "brain.drop_item",
          description: "Open one of the robot's grippers and release what it holds: where it is, or above an item. gripper_name is one of the names brain.get_state reports, or empty when exactly one gripper is holding an item. target_item_id is optional: give the item_id of a bowl or a box from brain.identify_item or brain.scan_items, and the robot carries the held item above it and opens there, with no descent; leave it out to open where the gripper is. Refused when that gripper holds nothing, when the name is empty while no gripper or more than one holds, and when target_item_id is unknown, is the held item, is held by another gripper, or is out of reach. Returns the gripper_name and the item_id released; the robot no longer reports holding it. To set the item down gently, use brain.place_item. Its progress gives each stage of the drop as it starts, with one sentence of what the robot does then.",
          operation: "long_running",
          safety_sensitive: true,
          // A drop above a target item is a carry and a release: the same
          // several-move budget as grab_item and place_item.
          deadline_ms: 120000,
        },
        {
          member: "place_item",
          tool: "brain.place_item",
          description: "Carry the item one of the robot's grippers holds into or onto another item, or to a pose, and release it there. gripper_name as for brain.drop_item. To put the item in or on another item, such as a bowl or a tray, give that item's item_id from brain.identify_item or brain.scan_items as target_item_id: the robot carries the held item above it, picks a free spot, lowers the item until it rests and opens there; target is then not read, so send position [0, 0, 0] alone, with no frame, timestamp or orientation. Without target_item_id, target is the grasp-point pose when the jaws open: frame and timestamp, which the robot places by the frame rule, and position, in meters, the release point, not a waypoint. The robot lowers the item to it and lets go where the item comes to rest on something on the way; final_point says where the jaws opened. orientation is left out to let the robot choose (the gripper pointing down); [0, 0, 0, 1] in the robot frame points the gripper up and cannot be planned. After a place the arm stands above where the item went and can hide that spot from the camera. Refused when the gripper holds nothing, when target_item_id is unknown, is the held item or is held by another gripper, when the target pose or the target item is unreachable, which the robot refuses rather than approximates, and with a kind of the frame rule for a target the robot cannot place. Returns the gripper_name, the item_id placed, and final_point, the measured grasp point when the jaws opened, in the robot frame at the time of that measurement, absent when success is false. Its progress gives each stage of the place as it starts, with one sentence of what the robot does then.",
          operation: "long_running",
          safety_sensitive: true,
          // A carry and a release: the same several-move budget as grab_item.
          deadline_ms: 120000,
        },
        {
          member: "abort",
          tool: "brain.abort",
          description: "Stop whatever sequence the robot's brain is running and leave the robot where it stopped, still holding whatever it held. reason is recorded by the robot; empty is accepted. Succeeds even when nothing was running, reporting an empty aborted_action. This is distinct from cancelling the running call or task: any caller may abort, not only the one that started the sequence.",
          operation: "long_running",
          deadline_ms: 5000,
        },
      ],
      services: [
        {
          member: "get_state",
          tool: "brain.get_state",
          description: "Report what the robot's brain is doing right now. current_action is the running sequence's name, empty when idle; current_action_elapsed_s is how long it has run. gripper_names lists the robot's grippers in a fixed order, the names the other brain tools accept, and holding and held_item_ids are index-aligned with it: true and the item_id where that gripper holds an item, false and empty otherwise. holding follows the brain's results, not the jaws: it turns true when brain.grab_item succeeds and false when brain.drop_item or brain.place_item does. gripper_openings, index-aligned too, is each gripper's opening as the robot last measured it, 0 closed to 1 fully open, empty until the robot has measured every gripper: an item that slipped out after a grab reads holding true and an opening near 0.",
          operation: "read_only",
          deadline_ms: 2000,
        },
      ],
    },

    // The model each role of a robot's brain runs, the models it takes, the
    // switch of one while the brain runs, and the forget of the world the
    // brain knew.
    brain_model: {
      contract: {
        name: "brain_model",
        tag: "v1",
        sha256: "6156b98578398bec8c949679e08223baed601c51c458903c44fd76c38de1da62",
      },
      actions: [
        {
          member: "switch_model",
          tool: "brain.switch_model",
          description: "Make model the active model of one role of the robot's brain while the brain runs. role is \"perception\", the model brain.scan_items and brain.identify_item use, or \"manipulation\", the model brain.grab_item, brain.drop_item and brain.place_item use; model is one of the names brain.list_models gives for that role. After the call, every goal of that role that starts uses the new model and brain.get_model reports it; a goal that was running finishes on the model it started with. Refused with precondition_failed while a goal of that role runs or another switch of that role runs, and with rejected for a role or a model the brain does not take; it fails with resource_unavailable when the brain cannot reach the model, and with attempt_failed when the model cannot serve the role. A refused, failed or cancelled switch leaves the role on its model. The brain checks that it reaches the model and that the model answers, not how well the model finds items. Starts no motion.",
          operation: "long_running",
          // A switch may reach a hosted model once before it answers.
          deadline_ms: 60000,
        },
      ],
      services: [
        {
          member: "get_model",
          tool: "brain.get_model",
          description: "Report the model each role of the robot's brain runs now: roles, models and starting, index-aligned, one entry per role. \"none\" is a role with no model, whose goals the brain refuses with precondition_failed. starting says why a role cannot serve a goal yet while the brain starts it, such as a model that still loads or a camera that has sent no frame yet, and is empty once the role can serve one. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "list_models",
          tool: "brain.list_models",
          description: "Report every model the robot's brain takes for each role: roles and models, index-aligned, one entry per model, grouped by role in the order brain.get_model gives. These are the names brain.switch_model takes. Changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "forget",
          tool: "brain.forget",
          description: "Make the robot's brain forget what it knows of the world around the robot: every item it remembers, and the item each of its grippers holds. Call it when that world changed while the brain did not look, such as a scene that was loaded, cleared or built again around the robot: else the brain sends a gripper to an item that is gone, and keeps a gripper holding an item that is gone. After the call, no gripper holds an item, as brain.get_state reports, and the brain refuses each item_id it gave before as one it no longer knows; brain.scan_items and brain.identify_item give the items they see again, each with a new item_id. item_ids names each item the brain forgot, the held ones among them, and is empty when it knew none. A goal that runs during the call ends as it would have: a grab that succeeds after the call holds its item. Starts no motion.",
          operation: "mutating",
          deadline_ms: 2000,
        },
      ],
    },

    // A robot's recorder, where it has one: it films the robot's cameras
    // and limbs into a dataset, an episode at a time.
    recorder: {
      contract: {
        name: "episode_recording",
        tag: "v1",
        sha256: "8703ed57f952f68f0ae64c991e3ff8d5af6abfec5ad95b6553f627c69b16a9f1",
      },
      actions: [
        {
          member: "record_episode",
          tool: "recorder.record_episode",
          description: "Record one episode of the robot into its open dataset session, under task as the episode's task description; feedback reports frames_recorded and disk_free_bytes as it runs. The task never completes: cancelling it ends the episode and saves it, and the recorder ends the episode itself, saved, at its maximum episode length, on low disk space, when a source goes silent or stale, when it cannot keep its frame rate and when it shuts down. Each of these ends the task cancelled, and its status message gives a reason that names the cause, and the result: episode_index of the saved episode, frames_recorded, and video_frames_missing, the frames that the shortest camera video of the episode misses against its state rows; an episode with missing frames should not be trained on. The recorder refuses an episode with precondition_failed while another episode records or a source is not ready, and fails it with attempt_failed when it cannot write or save the episode, whose frames are then dropped.",
          operation: "long_running",
          // Advertised to the client: recording accompanies motion.
          safety_sensitive: true,
          // The task parks in `input_required` until the client confirms
          // through `tasks/update`. No goal is sent before that, and only a
          // client with the tasks extension can call the tool.
          confirmation_required: true,
          deadline_ms: 900000,
        },
      ],
      // `finish_session` and `resume_session` are live on the recorder and
      // absent here: the operator opens and closes a dataset session, a
      // model records episodes into it.
    },
  },
}
