        name: "limb_state",
        tag: "v1",
        sha256: "9c1395e1d7e78a8bbafb92d0c0a1e671ca2a3db7c9f95fb0a2d0e2ca6f572658",
      },
      topics: [
        {
          member: "limb_states",
          resource: "robot.limb_state",
          description: "The robot's latest limb state: arm_names and gripper_names, joints_per_arm and joint_positions flattened arm by arm, grasp_points, the grasp-point pose of each arm, a position in meters and an orientation, a unit quaternion, in the order of arm_names, in frame, the robot frame, and gripper_openings as fractions of full jaw travel, all at timestamp.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 5 },
          // The arrays are variable-length, so the runtime size policy is
