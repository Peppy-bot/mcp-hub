// An AI brain as an MCP command surface: the item search, the four
// manipulation sequences, and the state query a model can ask a robot for,
// backed by the item_perception and item_manipulation contracts. Both are
// embodiment agnostic and so is this document: it names no robot, and the
// gripper names a model addresses come from brain.get_state at run time.
// Everything a client can see through this endpoint is named here; the
// implementer's own use of lower level contracts stays private, since a
// model reaches the arms through these sequences and not around them.
//
// Two targets, one per contract, so a launcher may fill them from one
// implementer or two. A launcher lists this document under
// `source: { exposures: ["ai_brain:v1"] }`, binds each target to a running
// implementer of its contract through `links`, and the server built into
// peppy serves it at `/ai_brain/v1/mcp` on the port it is given.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "ai_brain", tag: "v1" },

  // Advertised through `server/discover`. `instructions` is the prose a
  // model reads before it decides what to call, and the only place it learns
  // the sequence, the units, and the one-at-a-time rule: none of the
  // contracts' comments reach it.
  server: {
    title: "AI brain",
    instructions: "A robot with an AI brain that finds, picks up, and puts down items. Call brain.get_state first: it lists the gripper names this robot has, which gripper holds which item, and which sequence is running. Distances are meters. A pose is a gripper's grasp point in the robot's world frame: position [x, y, z] and orientation as a unit quaternion [x, y, z, w]. Orientation is optional everywhere; leave it out to let the robot choose how to approach or release. The usual sequence is brain.identify_item, then brain.grab_item with the item_id it returned, then brain.place_item or brain.drop_item. One manipulation sequence at a time: a manipulation tool called while another sequence is running is refused with the running action's name, and brain.abort stops whatever is running. brain.grab_item, brain.drop_item and brain.place_item move the robot; brain.identify_item and brain.abort start no motion.",
  },

  targets: {
    // LOGICAL targets, not instances: each becomes a contract slot of the
    // derived server node, and the launcher decides which running
    // implementer fills it. One implementer may fill both.
    item_perception: {
      contract: {
        name: "item_perception",
        tag: "v1",
        // An author pin: the sha256 of the exact contract document this file
        // was written against (`sha256sum robot/item_perception.json5` in the
        // contracts hub). A launch that resolves other bytes for
        // `item_perception:v1` refuses instead of publishing schemas this
        // file never saw.
        sha256: "72d6be95359a5829691920510f03fed94973d849d673640bb4bc60f94149acb0",
      },
      // The search becomes a tool backed by an MCP task: the call returns a
      // task handle and `tasks/get` reports its state until the result.
      actions: [
        {
          member: "identify_item",
          tool: "brain.identify_item",
          description: "Find one item and mint an item_id for it. description is what to look for, in your own words, or empty for the most prominent item the robot can act on; timeout_s bounds the search in seconds, 0 for the robot's default. Returns item_id, a label in the robot's own vocabulary, a world-frame position in meters, an orientation only when the robot resolved one, and confidence from 0 to 1. Finding nothing is a failure whose message says so. Starts no motion.",
          operation: "long_running",
          deadline_ms: 30000,
        },
      ],
    },

    item_manipulation: {
      contract: {
        name: "item_manipulation",
        tag: "v1",
        // Pinned like item_perception above
        // (`sha256sum robot/item_manipulation.json5`).
        sha256: "ea7c74526d902445231e3933f9943396399f5d2f9b54694664140e3f1a25bae0",
      },
      // Each action becomes a tool backed by an MCP task: the call returns a
      // task handle, `tasks/get` reports its state, and `tasks/cancel`
      // forwards to the action's cancel path. A goal the implementer refuses
      // at admission fails the task with the refusal as its message.
      actions: [
        {
          member: "grab_item",
          tool: "brain.grab_item",
          description: "Close a gripper on an item. gripper_name is one of the names brain.get_state reports, or empty to let the robot pick a free gripper suited to the item. Give item_id from brain.identify_item, or leave it empty and give position in meters and, optionally, orientation. max_effort caps the grip in the gripper's effort unit, 0 for the default. Refused when the gripper is unknown or already holds an item, when no gripper is free, or when item_id is one the robot no longer recognises. Returns the gripper_name and item_id now held; the robot reports it is holding the item from then on.",
          operation: "long_running",
          // Advertised to the client: this one moves the robot.
          safety_sensitive: true,
          // A reach, a close, and a check: several lower level moves in
          // sequence, so the deadline covers the whole sequence.
          deadline_ms: 120000,
        },
        {
          member: "drop_item",
          tool: "brain.drop_item",
          description: "Open a gripper where it is and release what it holds. gripper_name is one of the names brain.get_state reports, or empty when exactly one gripper is holding an item. Refused when that gripper holds nothing, or when the name is empty while no gripper or more than one holds. Returns the gripper_name and the item_id released; the robot no longer reports holding it. To carry the item somewhere first, use brain.place_item.",
          operation: "long_running",
          safety_sensitive: true,
          deadline_ms: 30000,
        },
        {
          member: "place_item",
          tool: "brain.place_item",
          description: "Carry the held item to a world-frame pose and release it there. gripper_name as for brain.drop_item. position is where the gripper's grasp point sits when the jaws open, in meters; it is the release point, not a waypoint. orientation is optional; leave it out to let the robot choose. Refused when the gripper holds nothing or the target is unreachable, which the robot refuses rather than approximates. Returns the gripper_name, the item_id placed, and the measured final_position.",
          operation: "long_running",
          safety_sensitive: true,
          // A carry and a release: the same several-move budget as grab_item.
          deadline_ms: 120000,
        },
        {
          member: "abort",
          tool: "brain.abort",
          description: "Stop whatever sequence is running and leave the robot where it stopped, still holding whatever it held. reason is recorded by the robot; empty is accepted. Succeeds even when nothing was running, reporting an empty aborted_action. This is distinct from cancelling a task: any caller may abort, without holding the running task's handle.",
          operation: "long_running",
          deadline_ms: 5000,
        },
      ],
      // The service becomes a tool that answers within one request.
      services: [
        {
          member: "get_state",
          tool: "brain.get_state",
          description: "Report what the brain is doing right now, with no arguments. current_action is the running sequence's name, empty when idle; current_action_elapsed_s is how long it has run. gripper_names lists this robot's grippers in a fixed order, the names the other tools accept, and holding and held_item_ids are index-aligned with it: true and the item_id where that gripper holds an item, false and empty otherwise.",
          operation: "read_only",
          deadline_ms: 2000,
        },
      ],
    },
  },
}
