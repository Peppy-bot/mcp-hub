// The materials of a simulated OpenArm v2's scene as an MCP command
// surface: discover the materials, read their effective values, set the
// colour or the finish of one, and restore the authored values. Every
// member edits the simulated world and nothing else: none of it exists on
// the physical robot, the title says so, the instructions open by saying
// so, and every description says so, so a model reading the endpoint never
// mistakes it for a real-robot surface. A change shows in every view the
// engine renders, the simulated cameras included; nothing here touches
// mass, friction or collision.
//
// This document is the whole artifact. A launcher lists it under
// `source: { exposures: ["scene_materials:v1"] }`, binds its one target to
// the running simulation through `links`, and the server built into peppy
// serves it at `/scene_materials/v1/mcp`. The launchers hub serves it
// through the `mcp_sim_commander` option of its simulated OpenArm v2
// fragment (`openarm/fragments/openarm_v2_sim.json5`), on port 8900 beside
// the robot endpoint `/openarm_v2/v1/mcp`, and its `openarm_simulation_mcp`
// launcher deploys it together with the scene, lighting and rendered-camera
// exposures beside this file. Exposures listed by one deployment share one
// server process, and a target name shared across them binds one contract,
// so the target here is named `materials`, apart from every target of the
// robot exposure and of the three sibling documents.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "scene_materials", tag: "v1" },

  // Advertised to clients through `server/discover`. `instructions` is the
  // prose a model reads before it decides what to call, and the only place
  // it learns the shared-scope rule, the units and the read-then-set
  // pattern: none of the contract's comments reach it. The opening sentence
  // and the title suffix are the wording rule
  // test_no_simulation_ground_truth.py enforces on every document under
  // simulation/.
  server: {
    title: "Scene materials (simulation only)",
    instructions: "This endpoint configures a simulated world. It has no effect on and no counterpart in the physical robot. The tools edit the optical properties of the materials in the scene the simulated OpenArm v2 stands in, and a change shows in every view the engine renders, the simulated cameras included; nothing here touches mass, friction or collision. Call materials.get_materials first: it lists every editable material with its id, label, scope and properties, and every material_id the setters take comes from it. A material is shared: every surface that references it changes together, and the scope reported for it (its owner, a robot instance or the scene; the count of surfaces sharing it; the bodies they belong to) says what an edit reaches before you make it. Colour is the base reflectance, linear RGB in the unit interval; metallic and roughness are the unit-interval parameters of the metallic-roughness model, 0 metallic a dielectric and 1 a conductor, 0 roughness a mirror finish and 1 fully diffuse. Read, then set: a setter validates its whole request before it changes anything, a refused request (unknown material, a value out of the unit interval or not finite) leaves the material as it was and says why in message, and every setter answers with the effective values after the call, so read the response rather than assuming the request took. materials.reset_materials restores the authored values, as loading or clearing a scene does.",
  },

  targets: {
    // A LOGICAL target, not an instance: `materials` becomes a contract
    // slot of the server, and the launcher binds it to the running
    // simulation engine, whichever engine that is.
    materials: {
      contract: {
        name: "scene_materials",
        tag: "v1",
        // An author pin: the sha256 of the exact contract document this file
        // was written against (`sha256sum simulation/scene_materials.json5`
        // in the contracts hub). A launch that resolves other bytes for
        // `scene_materials:v1` refuses instead of publishing schemas this
        // file never saw.
        sha256: "ff2ce6127fdc52c97bf3e743297a31ec8bea2d153085baf8ad34e8d1112e2953",
      },

      // Each service becomes a tool that answers within one request. The
      // setters are `mutating`; `restrict` narrows the finish's two scalars
      // to the unit interval at the endpoint, before the Peppy graph is
      // touched.
      services: [
        {
          member: "get_materials",
          tool: "materials.get_materials",
          description: "Report every editable material of the loaded simulated scene as a JSON object in materials_json: materials, each with id, label, scope (owner, a robot instance or the scene; surfaces, the count of surfaces sharing it; bodies, their body names) and properties (color_rgb, metallic, roughness), each with unit, default and value, plus min and max for the scalars. Every surface sharing a material changes with it, so the scope is what an edit reaches. success is false, with message saying why, while no scene is loaded. Takes no arguments and changes nothing.",
          operation: "read_only",
          deadline_ms: 5000,
        },
        {
          member: "set_material_color",
          tool: "materials.set_material_color",
          description: "Set a simulated material's base colour on every surface that shares it, color = linear RGB reflectance [r, g, b] in the unit interval. material_id comes from materials.get_materials; a refused request leaves the material as it was. Answers with current_color, the effective colour after the call.",
          operation: "mutating",
          deadline_ms: 5000,
        },
        {
          member: "set_material_finish",
          tool: "materials.set_material_finish",
          description: "Set a simulated material's finish on every surface that shares it: metallic and roughness, both in the unit interval (0 metallic a dielectric, 1 a conductor; 0 roughness a mirror finish, 1 fully diffuse), checked together and applied together. material_id comes from materials.get_materials; a refused request leaves the material as it was. Answers with current_metallic and current_roughness, the effective values after the call.",
          operation: "mutating",
          deadline_ms: 5000,
          // The contract's `f64` is unbounded; the metallic-roughness model
          // is defined on the unit interval.
          restrict: {
            metallic: { min: 0, max: 1 },
            roughness: { min: 0, max: 1 },
          },
        },
        {
          member: "reset_materials",
          tool: "materials.reset_materials",
          description: "Put every material of the loaded simulated scene back to its authored values, on every surface that shares each one. Takes no arguments.",
          operation: "mutating",
          deadline_ms: 5000,
        },
      ],
    },
  },
}
