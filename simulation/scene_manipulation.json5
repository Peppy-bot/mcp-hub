// The world of a simulated OpenArm v2 as an MCP command surface: the assets
// the engine can place, the scene to load or clear, the objects to spawn,
// move, push and remove, and the robot's base to relocate. Every member
// edits the simulated world and nothing else: none of it exists on the
// physical robot, the title says so, the instructions open by saying so,
// and every description says so, so a model reading the endpoint never
// mistakes it for a real-robot surface. What is spawned, and where it
// stands, is not read here: the engine's object_state contract reports it
// and stays inside the peppy framework, as the README's ground-truth rule
// says.
//
// This document is the whole artifact. A launcher lists it under
// `source: { exposures: ["scene_manipulation:v1"] }`, binds its one target
// to the running simulation through `links`, and the server built into
// peppy serves it at `/scene_manipulation/v1/mcp`. The launchers hub serves
// it through the `mcp_sim_commander` option of its simulated OpenArm v2
// fragment (`openarm/fragments/openarm_v2_sim.json5`), on port 8900 beside
// the robot endpoint `/openarm_v2/v1/mcp`, and its `openarm_simulation_mcp`
// launcher deploys it together with the lighting, materials and
// rendered-camera exposures beside this file. Exposures listed by one
// deployment share one server process, and a target name shared across
// them binds one contract, so the target here is named `scene`, apart from
// the robot exposure's `postures` and `limb_motion` and from every target
// of the three sibling documents.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "scene_manipulation", tag: "v1" },

  // Advertised to clients through `server/discover`. `instructions` is the
  // prose a model reads before it decides what to call, and the only place
  // it learns the id scheme, the units and the bounds: none of the
  // contract's comments reach it. The opening sentence and the title suffix
  // are the wording rule test_no_simulation_ground_truth.py enforces on
  // every document under simulation/.
  server: {
    title: "Scene manipulation (simulation only)",
    instructions: "This endpoint configures a simulated world. It has no effect on and no counterpart in the physical robot. The tools edit the scene of the simulation the OpenArm v2 runs in: scene.get_assets_list lists what the engine can place, scene.load_scene and scene.clear_scene replace the whole scene, scene.spawn_object, scene.move_object, scene.remove_object and scene.apply_force place, teleport, delete and push spawned objects, and scene.move_robot relocates the robot's base. Call scene.get_assets_list first: every asset_id comes from it and carries its kind as a prefix, scene/<id> for a scene and object/<id> for an object, and every object_id is minted by scene.spawn_object. Positions are world-frame [x, y, z] in metres, forces are world-frame newtons, masses are kilograms, durations are seconds; scale is uniform and 1 means as authored. Keep scale between 0.01 and 100, mass between 0 and 1000 kg and a push's duration_s between 0.01 and 30 s. Every tool answers with success and a message: a refused goal changes nothing in the simulation and the message says why. Loading or clearing a scene removes every spawned object and restores that scene's authored lighting and materials.",
  },

  targets: {
    // A LOGICAL target, not an instance: `scene` becomes a contract slot of
    // the server, and the launcher binds it to the running simulation
    // engine, whichever engine that is.
    scene: {
      contract: {
        name: "scene_manipulation",
        tag: "v1",
        // An author pin: the sha256 of the exact contract document this file
        // was written against (`sha256sum simulation/scene_manipulation.json5`
        // in the contracts hub). A launch that resolves other bytes for
        // `scene_manipulation:v1` refuses instead of publishing schemas this
        // file never saw.
        sha256: "0b9e083f9fce7e9f0b81feb742c289f8bb9d81f7a671684e0db0e6d30f264a6f",
      },

      // The catalogue becomes a tool that answers within one request.
      services: [
        {
          member: "get_assets_list",
          tool: "scene.get_assets_list",
          description: "List the assets the simulation can place, as a JSON array in assets_json. Every entry carries at least asset_id, display_name, kind (scene or object) and category, and the engine may add fields of its own. The asset_id values, scene/<id> and object/<id>, are what scene.load_scene and scene.spawn_object take. Takes no arguments and changes nothing.",
          operation: "read_only",
          deadline_ms: 5000,
        },
      ],

      // Each action becomes a tool backed by an MCP task: the call returns a
      // task handle, `tasks/get` reports its state, and `tasks/cancel`
      // forwards to the action's cancel path. The contract declares no
      // feedback topic, so a task carries its state transitions and the
      // terminal result, not interim progress.
      //
      // The bounds on scale, mass and duration_s live in the prose: an
      // action's goal fields take no `restrict` (the exposure format
      // narrows service requests only), so the engine's own refusal, with
      // its message, is what a goal outside them meets.
      actions: [
        {
          member: "load_scene",
          tool: "scene.load_scene",
          description: "Replace the simulated scene with the asset named by asset_id, which must be of kind scene (a scene/<id> from scene.get_assets_list); every spawned object is removed first and the scene's authored lighting and materials are restored. scale is a uniform scale applied to the scene, 1 = as authored; keep it between 0.01 and 100. success is false, with message saying why, when the scene is refused or fails to load.",
          operation: "long_running",
          // A scene load is the one goal that rebuilds the world, so it
          // gets the longer budget.
          deadline_ms: 60000,
        },
        {
          member: "clear_scene",
          tool: "scene.clear_scene",
          description: "Remove every spawned object from the simulation and restore its default scene, with that scene's authored lighting and materials. Takes no arguments.",
          operation: "long_running",
          deadline_ms: 60000,
        },
        {
          member: "spawn_object",
          tool: "scene.spawn_object",
          description: "Place one instance of an object asset in the simulation and report the object_id the engine minted for it. asset_id is an object/<id> from scene.get_assets_list; position is world-frame [x, y, z] in metres; scale is uniform, 1 = as authored, between 0.01 and 100; physics is dynamic (simulated, falls and collides), static (collides, never moves) or none (visual only); mass is the kilograms of a dynamic object, between 0 and 1000, and is ignored otherwise. object_id is empty on failure, when the asset is unknown, an argument is invalid or the spawn fails.",
          operation: "long_running",
          deadline_ms: 30000,
        },
        {
          member: "move_object",
          tool: "scene.move_object",
          description: "Teleport a spawned object in the simulation to a world-frame position [x, y, z] in metres, keeping its orientation and zeroing its velocity. object_id is the id scene.spawn_object reported.",
          operation: "long_running",
          deadline_ms: 30000,
        },
        {
          member: "remove_object",
          tool: "scene.remove_object",
          description: "Delete a spawned object from the simulation. object_id is the id scene.spawn_object reported.",
          operation: "long_running",
          deadline_ms: 30000,
        },
        {
          member: "apply_force",
          tool: "scene.apply_force",
          description: "Push a dynamic spawned object in the simulation with a constant world-frame force [x, y, z] in newtons for duration_s seconds, between 0.01 and 30. object_id is the id scene.spawn_object reported. The task completes once the push is scheduled, not when it ends.",
          operation: "long_running",
          // Advertised to the client: this one sets something in motion.
          safety_sensitive: true,
          deadline_ms: 30000,
        },
        {
          member: "move_robot",
          tool: "scene.move_robot",
          description: "Relocate the simulated robot's base to a world-frame position [x, y, z] in metres, keeping its joint configuration. The robot moves inside the simulation and nowhere else.",
          operation: "long_running",
          // Advertised to the client: this one moves the (simulated) robot.
          safety_sensitive: true,
          deadline_ms: 30000,
        },
      ],
    },
  },
}
