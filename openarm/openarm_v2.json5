// The OpenArm v2 as an MCP surface: its posture, arm and gripper moves as
// tools backed by MCP tasks, and its three cameras as resources and tools.
// This is the robot's own surface. The same document is served on the
// physical robot and on its simulated twin, whichever a launcher binds
// behind its targets, so everything a model does here transfers between
// them. The camera targets carry the rig's instance ids, wrist_left,
// wrist_right and chest, filled by the physical uvc and zed nodes or by
// the simulation's relays. The camera_profile contract is not published:
// no physical camera node implements it, and the setters below publish
// their bounds through restrict. Everything an MCP client can see through
// the endpoint is named in this file; the streamed teleop pairings, the
// joint-space move, the depth stream and the governor controls stay
// private.
//
// This document is the whole artifact. A launcher lists it under
// `source: { exposures: ["openarm_v2:v1"] }`, binds each target below to a
// running implementer of its contract through `links`, and the server built
// into peppy serves it at `/openarm_v2/v1/mcp`. The launchers hub deploys it
// as the `mcp_commander` option of its OpenArm robot fragments: the two move
// targets filled by the backbone, which is the same instance under the real
// robot and every simulation, and the three camera targets by the copy's
// rig, `cameras` on hardware and `cameras_sim` in simulation. A deployment's
// exposure list is fixed and every target takes a link, so the option
// requires a rig. `openarm_v2_demo.py` beside this file drives the four
// moves from the command line.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "openarm_v2", tag: "v1" },

  // Advertised to clients through `server/discover`. `instructions` is the
  // prose a model reads before it decides what to call, and the only place
  // it learns the limb names, the frames, the units and which device each
  // camera is: none of the contracts' comments reach it.
  server: {
    title: "OpenArm v2",
    instructions: "A bimanual OpenArm v2 and its three cameras. This is the robot's own surface: the same tools and resources drive the physical robot and its simulated twin, and everything done here transfers between them. Prefer it over any simulation endpoint: what the robot cannot do through these tools, it cannot do. Two arms and two grippers are addressed by name (left_arm / right_arm, left_gripper / right_gripper). Distances are meters, durations seconds, angles radians. A pose is the gripper's grasp point, midway between the finger pads, in the robot's world frame: position [x, y, z] and orientation as a unit quaternion [x, y, z, w]. Look before moving: wrist_left.latest_frame, wrist_right.latest_frame and chest.latest_frame are the latest JPEG frames of the two Arducam B0495 wrist modules and of the ZED Mini on the chest, and <camera>.info reports each stream's resolution, frame rate and encoding. Call openarm.move_to_ready before any openarm.move_arm; the rest posture is not a place to plan Cartesian moves from. One motion per limb at a time: a goal for a limb that is still moving is refused. Keep requested durations short: each move's task deadline is 60 s (30 s for openarm.move_gripper), a duration_s of 0 means as fast as the joint limits allow, and the robot refuses posture durations above 600 s outright. Every openarm tool moves the robot. The camera setters drive the device's controls: exposure on a wrist camera is in units of 100 microseconds, exposure on the chest camera is automatic only, gain is in device units (0 to 100 on a wrist camera, 0 to 8 on the chest camera), white balance temperature is in kelvin; brightness and contrast are not offered. A control the device does not support is refused, a refused request changes nothing and says why in message, and every setter answers with the effective value after the call, so read the response rather than assuming the request took.",
  },

  targets: {
    // A LOGICAL target, not an instance. `postures` becomes a contract slot
    // of the server, so the launcher decides which running instance fills
    // it. One target holds one contract, so the two contracts the backbone
    // serves are two targets, both bound to it by the launcher.
    postures: {
      contract: {
        name: "postures",
        tag: "v1",
        // An author pin: the sha256 of the exact contract document this file
        // was written against (`sha256sum robot/postures.json5` in the
        // contracts hub). A launch that resolves other bytes for
        // `postures:v1` refuses instead of publishing schemas this file
        // never saw.
        sha256: "316942d62a1924bc93b08828e2329a5da23b01bd8d169ac7aa525d0aad6b16d9",
      },

      // An action becomes a tool backed by an MCP task: the call returns a
      // task handle, `tasks/get` reports its progress, and `tasks/cancel`
      // forwards to the action's cancel path. Neither contract declares a
      // feedback topic, so a task carries its state transitions and the
      // terminal result, not interim progress.
      actions: [
        {
          member: "move_to_ready",
          tool: "openarm.move_to_ready",
          description: "Bring both arms to the working posture, raised out in front of the robot. duration_s is the requested move time in seconds; 0 means as fast as the joint limits allow.",
          operation: "long_running",
          // Advertised to the client: this one moves the robot.
          safety_sensitive: true,
          deadline_ms: 60000,
        },
        {
          member: "move_to_home",
          tool: "openarm.move_to_home",
          description: "Bring both arms to the rest posture, hanging at the robot's sides. duration_s is the requested move time in seconds; 0 means as fast as the joint limits allow.",
          operation: "long_running",
          safety_sensitive: true,
          deadline_ms: 60000,
        },
      ],
    },

    limb_motion: {
      contract: {
        name: "limb_motion",
        tag: "v1",
        // Pinned like `postures` above (`sha256sum robot/limb_motion.json5`).
        sha256: "a1a0c67b7866c66eaac6b76328f2d1312f00368a599d5569967274ff787d157f",
      },

      actions: [
        {
          member: "move_arm",
          tool: "openarm.move_arm",
          description: "Move one arm's grasp point to a world-frame pose. arm_name is left_arm or right_arm; position is [x, y, z] in meters and orientation a unit quaternion [x, y, z, w]; duration_s 0 means as fast as the joint limits allow. plan_position_tolerance_m and plan_orientation_tolerance_rad bound how far the planned pose may sit from the requested one (0 takes the planner's defaults); a pose no plan reaches inside both is refused rather than approximated.",
          operation: "long_running",
          safety_sensitive: true,
          deadline_ms: 60000,
        },
        {
          member: "move_gripper",
          tool: "openarm.move_gripper",
          description: "Drive one gripper to an opening. gripper_name is left_gripper or right_gripper; opening is a fraction of full jaw travel, 0 closed and 1 fully open; max_effort caps the effort toward the target, 0 meaning no preference.",
          operation: "long_running",
          safety_sensitive: true,
          deadline_ms: 30000,
        },
      ],
      // `move_arm_joints` is live on the backbone and deliberately absent
      // here: raw joint vectors are not a surface for a model, and the
      // contract leaves the joint count unpinned (the backbone's own
      // refinement pins 7), so a published schema for it could not say what
      // a goal means. A member that is not selected is not reachable
      // through the endpoint at all.
    },

    // The three camera targets carry the rig's own instance ids, and the
    // launcher binds each to the camera of the same name: a uvc node on
    // either wrist and the zed node on the chest of the physical robot, the
    // simulation's relays on its twin. `wrist_left` and `wrist_right` are
    // the two Arducam B0495 modules.
    wrist_left: {
      contract: {
        name: "rgb_camera",
        tag: "v1",
        // An author pin (`sha256sum cameras/rgb_camera.json5` in the
        // contracts hub); a launch that resolves other bytes for
        // `rgb_camera:v1` refuses.
        sha256: "a4e66999b7ec166569a73d25d430878823a368408e76d4aaa56e58ea89271b4f",
      },

      // The topic becomes a resource: the latest policy-approved snapshot,
      // published as JPEG at no more than 2 Hz however fast the camera
      // streams.
      topics: [
        {
          member: "video_stream",
          resource: "wrist_left.latest_frame",
          description: "Latest frame from the left wrist camera, an Arducam B0495 module, JPEG encoded.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "frame",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          // The frame is a variable-length byte array, so the runtime size
          // policy is mandatory.
          max_result_bytes: 524288,
          on_oversize: "downscale",
        },
      ],

      // Each service becomes a tool that answers within one request.
      // `restrict` narrows each request to the Arducam's range at the
      // endpoint, before the Peppy graph is touched, and is where a model
      // reads the bounds: no profile tool publishes them.
      services: [
        {
          member: "video_stream_info",
          tool: "wrist_left.info",
          description: "Report the left wrist camera stream's resolution, frame rate and encoding. Takes no arguments and changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "set_exposure",
          tool: "wrist_left.set_exposure",
          description: "Set the left wrist camera's exposure. mode is auto or manual; value is the manual exposure in units of 100 microseconds, 1 to 5000, and is ignored in auto mode. A refused request changes nothing. Answers with current_value, the effective exposure after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          // The contract's `i32` allows the whole 32-bit range; the Arducam
          // exposes 1..5000 hundred-microsecond steps.
          restrict: { value: { min: 1, max: 5000 } },
        },
        {
          member: "set_gain",
          tool: "wrist_left.set_gain",
          description: "Set the left wrist camera's gain in device units, 0 to 100. A refused request changes nothing. Answers with current_value, the effective gain after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { value: { min: 0, max: 100 } },
        },
        {
          member: "set_white_balance",
          tool: "wrist_left.set_white_balance",
          description: "Set the left wrist camera's white balance. mode is auto or manual; temperature is the manual colour temperature in kelvin, 2800 to 6500, and is ignored in auto mode. A refused request changes nothing. Answers with current_temperature, the effective temperature after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { temperature: { min: 2800, max: 6500 } },
        },
      ],
      // `set_brightness` and `set_contrast` are live on the camera and
      // deliberately absent here, on every camera of this rig: the devices
      // have no measured response for either, so the simulated twin has no
      // device model to answer them with and the two surfaces would differ.
      // A member that is not selected is not reachable through the endpoint
      // at all.
    },

    wrist_right: {
      contract: {
        name: "rgb_camera",
        tag: "v1",
        // Pinned like `wrist_left` above (`sha256sum cameras/rgb_camera.json5`).
        sha256: "a4e66999b7ec166569a73d25d430878823a368408e76d4aaa56e58ea89271b4f",
      },

      topics: [
        {
          member: "video_stream",
          resource: "wrist_right.latest_frame",
          description: "Latest frame from the right wrist camera, an Arducam B0495 module, JPEG encoded.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "frame",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          max_result_bytes: 524288,
          on_oversize: "downscale",
        },
      ],

      services: [
        {
          member: "video_stream_info",
          tool: "wrist_right.info",
          description: "Report the right wrist camera stream's resolution, frame rate and encoding. Takes no arguments and changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "set_exposure",
          tool: "wrist_right.set_exposure",
          description: "Set the right wrist camera's exposure. mode is auto or manual; value is the manual exposure in units of 100 microseconds, 1 to 5000, and is ignored in auto mode. A refused request changes nothing. Answers with current_value, the effective exposure after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { value: { min: 1, max: 5000 } },
        },
        {
          member: "set_gain",
          tool: "wrist_right.set_gain",
          description: "Set the right wrist camera's gain in device units, 0 to 100. A refused request changes nothing. Answers with current_value, the effective gain after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { value: { min: 0, max: 100 } },
        },
        {
          member: "set_white_balance",
          tool: "wrist_right.set_white_balance",
          description: "Set the right wrist camera's white balance. mode is auto or manual; temperature is the manual colour temperature in kelvin, 2800 to 6500, and is ignored in auto mode. A refused request changes nothing. Answers with current_temperature, the effective temperature after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { temperature: { min: 2800, max: 6500 } },
        },
      ],
      // `set_brightness` and `set_contrast` deliberately absent, as on
      // `wrist_left`.
    },

    // The chest viewpoint, a ZED Mini, an RGB-D producer. Only the colour
    // stream and the colour controls are published; `depth_stream` and
    // `depth_stream_info` are live on the camera and deliberately absent
    // here, since a z16 depth map is data, not a picture a JPEG resource
    // renders for a model to look at.
    chest: {
      contract: {
        name: "rgbd_camera",
        tag: "v1",
        // An author pin (`sha256sum cameras/rgbd_camera.json5` in the
        // contracts hub); a launch that resolves other bytes for
        // `rgbd_camera:v1` refuses.
        sha256: "61a2cc33ad04a82dd57e2afaf66b18c76ebfa1ca9b23f466825103e4513cef06",
      },

      topics: [
        {
          member: "video_stream",
          resource: "chest.latest_frame",
          description: "Latest colour frame from the chest camera, a ZED Mini, JPEG encoded.",
          freshness: { max_age_ms: 2000 },
          update: { max_hz: 2 },
          representation: {
            image: "jpeg",
            quality: 80,
            fields: {
              data: "frame",
              encoding: "encoding",
              width: "width",
              height: "height",
            },
          },
          max_result_bytes: 524288,
          on_oversize: "downscale",
        },
      ],

      // The tool names match the wrist cameras' so a model addresses every
      // camera the same way; the members are the rgbd contract's
      // `set_color_*`.
      services: [
        {
          member: "video_stream_info",
          tool: "chest.info",
          description: "Report the chest camera colour stream's resolution, frame rate and encoding. Takes no arguments and changes nothing.",
          operation: "read_only",
          deadline_ms: 2000,
        },
        {
          member: "set_color_exposure",
          tool: "chest.set_exposure",
          description: "Set the chest camera's colour exposure mode. The ZED Mini runs automatic exposure only, so only mode auto is accepted and mode manual is refused with success false; value is ignored either way and nothing changes on a refusal. Answers with current_value, the effective exposure after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          // No `restrict` on `value`: the device reads only `mode`.
        },
        {
          member: "set_color_gain",
          tool: "chest.set_gain",
          description: "Set the chest camera's colour gain in device units, 0 to 8. A refused request changes nothing. Answers with current_value, the effective gain after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          // The ZED Mini's gain runs 0..8, a narrower range than the wrists'.
          restrict: { value: { min: 0, max: 8 } },
        },
        {
          member: "set_color_white_balance",
          tool: "chest.set_white_balance",
          description: "Set the chest camera's colour white balance. mode is auto or manual; temperature is the manual colour temperature in kelvin, 2800 to 6500, and is ignored in auto mode. A refused request changes nothing. Answers with current_temperature, the effective temperature after the call.",
          operation: "mutating",
          deadline_ms: 2000,
          restrict: { temperature: { min: 2800, max: 6500 } },
        },
      ],
      // `set_color_brightness` and `set_color_contrast` deliberately
      // absent, as on the wrists.
    },
  },
}
